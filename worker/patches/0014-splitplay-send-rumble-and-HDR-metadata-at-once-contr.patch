+  /**
+   * @brief SplitPlay: ENet intercept that turns the control doorbell (src/splitplay/doorbell.h) into a wake-up.
+   *
+   * @param host The control server's ENet host; the received datagram is in receivedData.
+   * @param event The event enet_host_service() will return.
+   * @return 1 for the doorbell (consumed, enet_host_service() returns), 0 for an ENet datagram.
+   */
+  static int ENET_CALLBACK splitplay_doorbell_intercept(ENetHost *host, ENetEvent *event) {
+    if (!splitplay::doorbell::is_ring(host->receivedData, host->receivedDataLength)) {
+      return 0;
+    }
+    if (event) {
+      // Any event type but NONE ends enet_host_service(); iterate() recognises this one by its missing peer.
+      event->type = ENET_EVENT_TYPE_RECEIVE;
+      event->peer = nullptr;
+      event->packet = nullptr;
+      event->data = 0;
+    }
+    return 1;
+  }
+
   void control_server_t::iterate(std::chrono::milliseconds timeout) {
     ENetEvent event;
     auto res = enet_host_service(_host.get(), &event, (enet_uint32) timeout.count());
 
+    if (res > 0 && !event.peer) {
+      // SplitPlay: the control doorbell; the caller's loop sends the queued feedback now
+      return;
+    }
+
     if (res > 0) {
       auto session = get_session(event.peer, event.data);
       if (!session) {
@@ -1263,6 +1290,17 @@ namespace stream {
     platf::adjust_thread_priority(platf::thread_priority_e::critical);
     splitplay::scheduling::mmcss_t mmcss {"stream::controlBroadcast (input receive)"};  // SplitPlay
 
+    // SplitPlay: gamepad feedback and HDR metadata ring the doorbell, which ends the wait in iterate() below, so they
+    // go out at once instead of on the next ping or input packet (up to ~100 ms later)
+    server->_host.get()->intercept = splitplay_doorbell_intercept;
+    {
+      const auto af = net::af_from_enum_string(config::sunshine.address_family);
+      splitplay::doorbell::arm(net::map_port(CONTROL_PORT), net::get_bind_address(af), af != net::IPV4);
+    }
+    auto doorbell_guard = util::fail_guard([]() {
+      splitplay::doorbell::disarm();
+    });
+
     // Check for both the full shutdown event and the shutdown event for this
     // broadcast to ensure we can inform connected clients of our graceful
     // termination when we shut down.
@@ -1271,6 +1309,9 @@ namespace stream {
     while (!shutdown_event->peek() && !broadcast_shutdown_event->peek()) {
       bool has_session_awaiting_peer = false;
 
+      // SplitPlay: whatever is queued from here on is drained below or rings again
+      splitplay::doorbell::rearm();
+
       {
         auto lg = server->_sessions.lock();
 
