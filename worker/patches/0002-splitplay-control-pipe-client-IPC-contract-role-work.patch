diff --git a/src/splitplay/control_client.cpp b/src/splitplay/control_client.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..01c4e88533a34025e4556c0401c047d3c61eca33
--- /dev/null
+++ b/src/splitplay/control_client.cpp
@@ -0,0 +1,510 @@
+/**
+ * @file src/splitplay/control_client.cpp
+ * @brief Child side of the SplitPlay control IPC (docs/contracts/ipc.md, role "worker").
+ *
+ * Transport: the service creates `\\.\pipe\splitplay\worker-<desk-id>` before starting the worker and passes it
+ * with `--pipe`. Byte mode, UTF-8, one JSON object per `\n`-terminated line, at most 64 KiB per line.
+ * The pipe is opened for overlapped I/O so that the reader thread and the writers never serialise on one handle.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+// SplitPlay contract headers (MIT, copied unmodified from native/include/splitplay by worker/scripts/fetch.sh)
+#include <splitplay/trace.h>
+
+// local includes
+#include "control_client.h"
+#include "options.h"
+#include "src/config.h"
+#include "src/entry_handler.h"
+#include "src/logging.h"
+#include "src/network.h"
+#include "src/nvhttp.h"
+#include "src/rtsp.h"
+
+#ifdef _WIN32
+  // platform includes
+  #include <winsock2.h>
+  #include <ws2tcpip.h>
+  #include <windows.h>
+#endif
+
+using namespace std::literals;
+using json = nlohmann::json;
+
+namespace splitplay::control {
+#ifdef _WIN32
+  namespace {
+    constexpr int protocol_version = 1;  ///< docs/contracts/ipc.md protocol version.
+    constexpr std::size_t max_line_bytes = 64 * 1024;  ///< Longest accepted line, newline excluded.
+    constexpr auto heartbeat_interval = 1000ms;
+    constexpr auto welcome_timeout = 10s;
+    constexpr auto connect_timeout = 5s;
+    constexpr auto ready_port_timeout = 10s;
+    constexpr DWORD write_timeout_ms = 5000;
+    constexpr int exit_code_pipe_lost = 3;  ///< Process exit code when the service goes away.
+
+    std::wstring to_wide(const std::string &utf8) {
+      if (utf8.empty()) {
+        return {};
+      }
+      const int size = MultiByteToWideChar(CP_UTF8, 0, utf8.data(), static_cast<int>(utf8.size()), nullptr, 0);
+      std::wstring out(static_cast<std::size_t>(size), L'\0');
+      MultiByteToWideChar(CP_UTF8, 0, utf8.data(), static_cast<int>(utf8.size()), out.data(), size);
+      return out;
+    }
+
+    DWORD own_session_id() {
+      DWORD session = 0;
+      if (!ProcessIdToSessionId(GetCurrentProcessId(), &session)) {
+        return 0xFFFFFFFF;
+      }
+      return session;
+    }
+
+    /**
+     * @brief True once something accepts TCP connections on 127.0.0.1:port.
+     */
+    bool loopback_port_open(std::uint16_t port) {
+      SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+      if (s == INVALID_SOCKET) {
+        return false;
+      }
+      sockaddr_in addr {};
+      addr.sin_family = AF_INET;
+      addr.sin_port = htons(port);
+      addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+      const bool ok = ::connect(s, reinterpret_cast<const sockaddr *>(&addr), sizeof(addr)) == 0;
+      closesocket(s);
+      return ok;
+    }
+
+    /**
+     * @brief One connection to the service.
+     */
+    class client_t {
+    public:
+      client_t():
+          stop_event {CreateEventW(nullptr, TRUE, FALSE, nullptr)},
+          write_event {CreateEventW(nullptr, TRUE, FALSE, nullptr)} {
+      }
+
+      client_t(const client_t &) = delete;
+      client_t &operator=(const client_t &) = delete;
+
+      ~client_t() {
+        shutdown();
+        if (stop_event) {
+          CloseHandle(stop_event);
+        }
+        if (write_event) {
+          CloseHandle(write_event);
+        }
+      }
+
+      bool connect(const std::string &pipe_name) {
+        const auto wide = to_wide(pipe_name);
+        const auto deadline = std::chrono::steady_clock::now() + connect_timeout;
+        for (;;) {
+          // SECURITY_IDENTIFICATION: the service may identify, but never impersonate, the worker's token.
+          pipe = CreateFileW(wide.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, FILE_FLAG_OVERLAPPED | SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION, nullptr);
+          if (pipe != INVALID_HANDLE_VALUE) {
+            return true;
+          }
+          const DWORD err = GetLastError();
+          if (std::chrono::steady_clock::now() >= deadline || (err != ERROR_PIPE_BUSY && err != ERROR_FILE_NOT_FOUND)) {
+            BOOST_LOG(error) << "SplitPlay: cannot open control pipe "sv << pipe_name << " [error "sv << err << ']';
+            return false;
+          }
+          if (err == ERROR_PIPE_BUSY) {
+            WaitNamedPipeW(wide.c_str(), 500);
+          } else {
+            std::this_thread::sleep_for(100ms);
+          }
+        }
+      }
+
+      /**
+       * @brief Send hello, start the reader and wait for welcome.
+       */
+      bool handshake(const options_t &opts) {
+        json hello {
+          {"type", "hello"},
+          {"protocol", protocol_version},
+          {"role", "worker"},
+          {"desk", opts.desk},
+          {"pid", GetCurrentProcessId()},
+          {"version", splitplay::version()},
+          {"session", own_session_id()},
+        };
+        if (!send(hello)) {
+          BOOST_LOG(error) << "SplitPlay: failed to send hello"sv;
+          return false;
+        }
+
+        reader = std::thread {&client_t::read_loop, this};
+
+        std::unique_lock lk {state_mutex};
+        if (!state_cv.wait_for(lk, welcome_timeout, [this]() {
+              return welcomed || failed;
+            })) {
+          BOOST_LOG(error) << "SplitPlay: no welcome from the service within "sv << welcome_timeout.count() << " s"sv;
+          return false;
+        }
+        if (failed) {
+          return false;
+        }
+        handshake_done = true;
+        lk.unlock();
+
+        heartbeat = std::jthread {[this](std::stop_token st) {
+          heartbeat_loop(st);
+        }};
+        return true;
+      }
+
+      void send_ready() {
+        // "ready" means the ports are listening: wait for the HTTP port (base port) to accept connections.
+        const auto port = net::map_port(nvhttp::PORT_HTTP);
+        const auto deadline = std::chrono::steady_clock::now() + ready_port_timeout;
+        bool listening = false;
+        while (!stopping && !(listening = loopback_port_open(port)) && std::chrono::steady_clock::now() < deadline) {
+          std::this_thread::sleep_for(100ms);
+        }
+        if (!listening) {
+          BOOST_LOG(warning) << "SplitPlay: HTTP port "sv << port << " is not reachable on loopback yet, sending ready anyway"sv;
+        }
+        ready = true;
+        send({{"type", "ready"}, {"ports", {{"base", config::sunshine.port}}}});
+        BOOST_LOG(info) << "SplitPlay: ready (base port "sv << config::sunshine.port << ')';
+      }
+
+      void shutdown() {
+        stopping = true;
+        if (stop_event) {
+          SetEvent(stop_event);
+        }
+        if (heartbeat.joinable()) {
+          heartbeat.request_stop();
+          heartbeat.join();
+        }
+        if (reader.joinable()) {
+          reader.join();
+        }
+        if (pipe != INVALID_HANDLE_VALUE) {
+          CloseHandle(pipe);
+          pipe = INVALID_HANDLE_VALUE;
+        }
+      }
+
+    private:
+      bool send(const json &msg) {
+        std::string line = msg.dump(-1, ' ', false, json::error_handler_t::replace);
+        line += '\n';
+
+        std::lock_guard lg {write_mutex};
+        if (pipe == INVALID_HANDLE_VALUE) {
+          return false;
+        }
+        OVERLAPPED ov {};
+        ov.hEvent = write_event;
+        ResetEvent(write_event);
+        DWORD written = 0;
+        if (!WriteFile(pipe, line.data(), static_cast<DWORD>(line.size()), nullptr, &ov)) {
+          if (GetLastError() != ERROR_IO_PENDING) {
+            on_broken(GetLastError());
+            return false;
+          }
+          if (WaitForSingleObject(write_event, write_timeout_ms) != WAIT_OBJECT_0) {
+            CancelIoEx(pipe, &ov);
+            GetOverlappedResult(pipe, &ov, &written, TRUE);
+            BOOST_LOG(error) << "SplitPlay: control pipe write timed out"sv;
+            on_broken(ERROR_TIMEOUT);
+            return false;
+          }
+        }
+        if (!GetOverlappedResult(pipe, &ov, &written, FALSE) || written != line.size()) {
+          on_broken(GetLastError());
+          return false;
+        }
+        return true;
+      }
+
+      void reply_ok(const std::optional<std::int64_t> &id, json data = nullptr) {
+        if (!id) {
+          return;
+        }
+        json msg {{"type", "result"}, {"id", *id}, {"ok", true}};
+        if (!data.is_null()) {
+          msg["data"] = std::move(data);
+        }
+        send(msg);
+      }
+
+      void reply_error(const std::optional<std::int64_t> &id, std::string_view code, std::string_view message) {
+        if (!id) {
+          return;
+        }
+        send({{"type", "result"}, {"id", *id}, {"ok", false}, {"error", {{"code", code}, {"message", message}}}});
+      }
+
+      void request_exit(int code) {
+        if (!exit_requested.exchange(true)) {
+          lifetime::exit_sunshine(code, true);
+        }
+      }
+
+      void on_broken(DWORD err) {
+        if (stopping) {
+          return;
+        }
+        {
+          std::lock_guard lk {state_mutex};
+          if (!handshake_done) {
+            // During the handshake the caller reports the failure and main() returns.
+            failed = true;
+            state_cv.notify_all();
+            return;
+          }
+        }
+        if (!exit_requested) {
+          BOOST_LOG(warning) << "SplitPlay: control pipe closed [error "sv << err << "], exiting (the worker never runs unsupervised)"sv;
+        }
+        request_exit(exit_code_pipe_lost);
+      }
+
+      void heartbeat_loop(std::stop_token st) {
+        std::mutex m;
+        std::condition_variable_any cv;
+        std::uint64_t seq = 0;
+        while (!st.stop_requested() && !stopping) {
+          const int clients = rtsp_stream::session_count();
+          const char *state = !ready ? "starting" : (clients > 0 ? "streaming" : "idle");
+          send({
+            {"type", "heartbeat"},
+            {"seq", ++seq},
+            {"state", state},
+            {"metrics", {
+                          {"fps", 0},
+                          {"bitrate_kbps", 0},
+                          {"encode_ms_p50", 0},
+                          {"encode_ms_p99", 0},
+                          {"loss_pct", 0},
+                          {"clients", clients},
+                        }},
+          });
+          std::unique_lock lk {m};
+          cv.wait_for(lk, st, heartbeat_interval, []() {
+            return false;
+          });
+        }
+      }
+
+      void read_loop() {
+        HANDLE read_event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        std::string buffer;
+        bool discarding = false;  // inside an over-long line, skip until the next newline
+        char chunk[4096];
+
+        for (;;) {
+          OVERLAPPED ov {};
+          ov.hEvent = read_event;
+          ResetEvent(read_event);
+          DWORD n = 0;
+          BOOL ok = ReadFile(pipe, chunk, sizeof(chunk), nullptr, &ov);
+          DWORD err = ok ? ERROR_SUCCESS : GetLastError();
+          if (ok || err == ERROR_IO_PENDING) {
+            if (!ok) {
+              HANDLE handles[] = {read_event, stop_event};
+              if (WaitForMultipleObjects(2, handles, FALSE, INFINITE) != WAIT_OBJECT_0) {
+                CancelIoEx(pipe, &ov);
+                GetOverlappedResult(pipe, &ov, &n, TRUE);
+                break;  // stop requested
+              }
+            }
+            ok = GetOverlappedResult(pipe, &ov, &n, FALSE);
+            err = ok ? ERROR_SUCCESS : GetLastError();
+          }
+          if (!ok && err != ERROR_MORE_DATA) {
+            on_broken(err);
+            break;
+          }
+
+          for (DWORD i = 0; i < n; ++i) {
+            const char c = chunk[i];
+            if (c == '\n') {
+              if (!discarding && !buffer.empty()) {
+                handle_line(buffer);
+              }
+              buffer.clear();
+              discarding = false;
+            } else if (!discarding) {
+              buffer.push_back(c);
+              if (buffer.size() > max_line_bytes) {
+                BOOST_LOG(error) << "SplitPlay: control message longer than 64 KiB dropped"sv;
+                buffer.clear();
+                discarding = true;
+              }
+            }
+          }
+        }
+        CloseHandle(read_event);
+      }
+
+      void handle_line(std::string_view line) {
+        if (!line.empty() && line.back() == '\r') {
+          line.remove_suffix(1);
+        }
+        json msg = json::parse(line, nullptr, false);
+        if (msg.is_discarded() || !msg.is_object()) {
+          BOOST_LOG(warning) << "SplitPlay: ignoring malformed control message"sv;
+          return;
+        }
+        const std::string type = msg.contains("type") && msg["type"].is_string() ? msg["type"].get<std::string>() : std::string {};
+        std::optional<std::int64_t> id;
+        if (msg.contains("id") && msg["id"].is_number_integer()) {
+          id = msg["id"].get<std::int64_t>();
+        }
+
+        try {
+          if (type == "welcome") {
+            on_welcome(msg);
+          } else if (type == "shutdown") {
+            BOOST_LOG(info) << "SplitPlay: shutdown requested by the service"sv;
+            reply_ok(id);
+            request_exit(0);
+          } else if (type == "set_profile") {
+            // Live profile changes (ARCHITECTURE.md section 9) are applied from Stage 3 on.
+            BOOST_LOG(info) << "SplitPlay: set_profile is not supported yet: "sv << msg.value("profile", json::object()).dump();
+            reply_error(id, "unsupported", "live profile changes are not implemented in this worker version");
+          } else if (type == "pair") {
+            const auto pin = msg.value("pin", std::string {});
+            const auto name = msg.value("name", std::string {});
+            if (nvhttp::pin(pin, name)) {
+              reply_ok(id);
+            } else {
+              reply_error(id, "pair_failed", "no pending pairing request, or the PIN was rejected");
+            }
+          } else if (type == "list_clients") {
+            reply_ok(id, {{"clients", nvhttp::get_all_clients()}});
+          } else if (type == "unpair") {
+            const auto client = msg.value("client", std::string {});
+            const auto cert = nvhttp::get_cert_by_uuid(client);
+            if (nvhttp::unpair_client(client)) {
+              if (!cert.empty()) {
+                rtsp_stream::terminate_sessions_by_cert(cert);
+              }
+              reply_ok(id);
+            } else {
+              reply_error(id, "not_found", "no paired client with this uuid");
+            }
+          } else if (type == "send_sas") {
+            reply_error(id, "unsupported", "send_sas is handled by the seat");
+          } else if (type == "result") {
+            // The worker sends no requests yet, so there is nothing to match.
+          } else if (id) {
+            reply_error(id, "unknown_type", "unknown message type: " + type);
+          }
+        } catch (const std::exception &e) {
+          BOOST_LOG(error) << "SplitPlay: control message "sv << type << " failed: "sv << e.what();
+          reply_error(id, "internal", e.what());
+        }
+      }
+
+      void on_welcome(const json &msg) {
+        std::lock_guard lk {state_mutex};
+        if (welcomed) {
+          return;
+        }
+        const int protocol = msg.value("protocol", 0);
+        if (protocol != protocol_version) {
+          BOOST_LOG(error) << "SplitPlay: service speaks control protocol "sv << protocol << ", worker speaks "sv << protocol_version;
+          failed = true;
+        } else {
+          welcomed = true;
+          profile = msg.value("profile", json::object());
+          BOOST_LOG(info) << "SplitPlay: welcome received, initial profile "sv << profile.dump();
+        }
+        state_cv.notify_all();
+      }
+
+      HANDLE pipe = INVALID_HANDLE_VALUE;
+      HANDLE stop_event = nullptr;
+      HANDLE write_event = nullptr;
+      std::mutex write_mutex;
+      std::thread reader;
+      std::jthread heartbeat;
+
+      std::mutex state_mutex;
+      std::condition_variable state_cv;
+      bool welcomed = false;
+      bool failed = false;
+      bool handshake_done = false;
+      json profile;  ///< Initial profile from welcome; applied from Stage 3 on.
+
+      std::atomic_bool stopping {false};
+      std::atomic_bool exit_requested {false};
+      std::atomic_bool ready {false};
+    };
+
+    std::unique_ptr<client_t> client;
+  }  // namespace
+
+  int start() {
+    const auto &opts = options();
+    if (opts.pipe.empty()) {
+      BOOST_LOG(info) << "SplitPlay: no --pipe given, running standalone"sv;
+      return 0;
+    }
+
+    BOOST_LOG(info) << "SplitPlay: desk "sv << opts.desk << " (trace hash "sv << sp_desk_hash(opts.desk.c_str()) << "), session "sv << own_session_id() << ", control pipe "sv << opts.pipe;
+
+    WSADATA wsa;
+    WSAStartup(MAKEWORD(2, 2), &wsa);  // reference counted; balanced by the process exit
+
+    client = std::make_unique<client_t>();
+    if (!client->connect(opts.pipe) || !client->handshake(opts)) {
+      client.reset();
+      return 1;
+    }
+    return 0;
+  }
+
+  void notify_ready() {
+    if (client) {
+      client->send_ready();
+    }
+  }
+
+  void stop() {
+    client.reset();
+  }
+#else
+  int start() {
+    if (!options().pipe.empty()) {
+      BOOST_LOG(error) << "SplitPlay: the control pipe is only implemented on Windows"sv;
+      return 1;
+    }
+    return 0;
+  }
+
+  void notify_ready() {
+  }
+
+  void stop() {
+  }
+#endif
+}  // namespace splitplay::control
