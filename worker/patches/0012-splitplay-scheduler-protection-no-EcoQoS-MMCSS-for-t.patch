diff --git a/src/splitplay/scheduling.cpp b/src/splitplay/scheduling.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b9ab70f33dc1bfec24654651bb81ce8d7a982b98
--- /dev/null
+++ b/src/splitplay/scheduling.cpp
@@ -0,0 +1,112 @@
+/**
+ * @file src/splitplay/scheduling.cpp
+ * @brief Scheduler protection for the SplitPlay worker (see scheduling.h).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <memory>
+#include <string>
+
+// local includes
+#include "scheduling.h"
+#include "src/logging.h"
+
+#ifdef _WIN32
+  // platform includes
+  #include <windows.h>
+  #include <avrt.h>
+  #include <processthreadsapi.h>
+
+  #ifndef PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION
+    #define PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION 0x4
+  #endif
+#endif
+
+using namespace std::literals;
+
+namespace splitplay::scheduling {
+#ifdef _WIN32
+  namespace {
+    /// MMCSS task of the capture, encode, video send and input threads (see scheduling.h for the choice).
+    constexpr const wchar_t *mmcss_task = L"Games";
+
+    /**
+     * @brief ControlMask set with StateMask clear: "never throttle this", for every flag in `mask`.
+     */
+    bool opt_out_of_power_throttling(ULONG mask) {
+      PROCESS_POWER_THROTTLING_STATE state {};
+      state.Version = PROCESS_POWER_THROTTLING_CURRENT_VERSION;
+      state.ControlMask = mask;
+      state.StateMask = 0;
+      return SetProcessInformation(GetCurrentProcess(), ProcessPowerThrottling, &state, sizeof(state)) != FALSE;
+    }
+  }  // namespace
+
+  void apply_process_policy() {
+    // EXECUTION_SPEED: no EcoQoS (efficiency cores, lowered clocks) for a process Windows considers in the background.
+    // IGNORE_TIMER_RESOLUTION: keep honouring the 0.5-1 ms timer resolution upstream requests while streaming
+    // (Windows 11 may ignore it for processes without a visible window; the worker never has one).
+    std::string throttling;
+    if (opt_out_of_power_throttling(PROCESS_POWER_THROTTLING_EXECUTION_SPEED | PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION)) {
+      throttling = "off (execution speed, timer resolution)";
+    } else if (const DWORD err = GetLastError(); opt_out_of_power_throttling(PROCESS_POWER_THROTTLING_EXECUTION_SPEED)) {
+      // Windows 10 does not know the timer-resolution flag.
+      throttling = "off (execution speed; timer resolution flag refused, error " + std::to_string(err) + ")";
+    } else {
+      throttling = "unchanged (SetProcessInformation error " + std::to_string(GetLastError()) + ")";
+    }
+
+    std::string priority = "above normal (high while streaming)";
+    if (!SetPriorityClass(GetCurrentProcess(), idle_priority_class())) {
+      priority = "unchanged (SetPriorityClass error " + std::to_string(GetLastError()) + ")";
+    }
+
+    BOOST_LOG(info) << "SplitPlay: scheduling: power throttling "sv << throttling << ", priority class "sv << priority
+                    << ", MMCSS \"Games\" for the capture, encode, video send and input threads"sv;
+  }
+
+  unsigned long idle_priority_class() {
+    return ABOVE_NORMAL_PRIORITY_CLASS;
+  }
+
+  mmcss_t::mmcss_t(const char *what) {
+    DWORD task_index = 0;
+    handle = AvSetMmThreadCharacteristicsW(mmcss_task, &task_index);
+    if (!handle) {
+      BOOST_LOG(warning) << "SplitPlay: MMCSS refused "sv << what << " [error "sv << GetLastError() << "], it keeps its normal priority"sv;
+      return;
+    }
+    if (!AvSetMmThreadPriority(handle, AVRT_PRIORITY_HIGH)) {
+      BOOST_LOG(warning) << "SplitPlay: MMCSS priority for "sv << what << " not set [error "sv << GetLastError() << ']';
+    }
+    BOOST_LOG(info) << "SplitPlay: "sv << what << " runs under MMCSS \"Games\", priority high"sv;
+  }
+
+  mmcss_t::~mmcss_t() {
+    if (handle) {
+      AvRevertMmThreadCharacteristics(handle);
+    }
+  }
+#else
+  void apply_process_policy() {
+  }
+
+  unsigned long idle_priority_class() {
+    return 0;
+  }
+
+  mmcss_t::mmcss_t(const char *) {
+  }
+
+  mmcss_t::~mmcss_t() {
+  }
+#endif
+
+  void join_mmcss_for_this_thread(const char *what) {
+    // Destroyed (and the registration reverted) when the thread ends.
+    thread_local std::unique_ptr<mmcss_t> registration;
+    if (!registration) {
+      registration = std::make_unique<mmcss_t>(what);
+    }
+  }
+}  // namespace splitplay::scheduling
diff --git a/src/splitplay/scheduling.h b/src/splitplay/scheduling.h
new file mode 100644
index 0000000000000000000000000000000000000000..acbba8a2e33bc24c1236ea38946f3a39fbbfe667
--- /dev/null
+++ b/src/splitplay/scheduling.h
@@ -0,0 +1,55 @@
+/**
+ * @file src/splitplay/scheduling.h
+ * @brief Scheduler protection for the SplitPlay worker: no EcoQoS, raised priority class, MMCSS for the hot threads.
+ *
+ * Several desks share one PC with the games they stream. Without these settings a worker in a non-console RDP
+ * session (no window, never "visible") is a candidate for EcoQoS and timer-resolution throttling on Windows 11, and
+ * its streaming threads tie with a game's TIME_CRITICAL thread at priority 15.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+namespace splitplay::scheduling {
+  /**
+   * @brief Opt the process out of power throttling (EcoQoS and ignored timer-resolution requests) and raise its
+   * priority class to ABOVE_NORMAL. Upstream still switches to HIGH while a stream runs; patched
+   * `streaming_will_stop()` returns to idle_priority_class() instead of NORMAL. Logs what was applied.
+   */
+  void apply_process_policy();
+
+  /**
+   * @brief The priority class of an idle worker (no stream): ABOVE_NORMAL_PRIORITY_CLASS on Windows.
+   */
+  unsigned long idle_priority_class();
+
+  /**
+   * @brief Registers the calling thread with the MMCSS task "Games" at AVRT_PRIORITY_HIGH while the object lives.
+   *
+   * "Games" (scheduling category Medium by default, priorities 16-22) runs above every thread of a game in the normal
+   * priority class (at most 15) and below the High category of "Audio"/"Pro Audio" that the session's audio engine
+   * and Sunshine's own audio capture use, so a stream never takes the CPU from audio. MMCSS keeps its reserve for
+   * other threads (SystemResponsiveness, 20 % by default), so a busy worker cannot starve the PC.
+   */
+  class mmcss_t {
+  public:
+    /**
+     * @param what Thread name for the log.
+     */
+    explicit mmcss_t(const char *what);
+    ~mmcss_t();
+
+    mmcss_t(const mmcss_t &) = delete;
+    mmcss_t &operator=(const mmcss_t &) = delete;
+
+  private:
+    void *handle = nullptr;
+  };
+
+  /**
+   * @brief Register the calling thread with MMCSS (as mmcss_t) once, until the thread ends.
+   * For pool threads that run the input path: the registration is made on their first input message.
+   *
+   * @param what Thread name for the log.
+   */
+  void join_mmcss_for_this_thread(const char *what);
+}  // namespace splitplay::scheduling
