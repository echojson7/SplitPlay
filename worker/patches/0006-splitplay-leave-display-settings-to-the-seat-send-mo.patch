   void configure_display(const config::video_t &video_config, const rtsp_stream::launch_session_t &session) {
+#ifdef _WIN32
+    // SplitPlay: ask the service (and through it the seat) for the client's mode instead of changing it here.
+    // The wait lets encoder probing and capture start on the new size; a refused request costs at most 3 s.
+    splitplay::control::request_mode(session.width, session.height, session.fps, std::chrono::seconds {3});
