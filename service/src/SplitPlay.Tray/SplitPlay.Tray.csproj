<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SplitPlay.Tray</RootNamespace>
    <AssemblyName>SplitPlay.Tray</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- WinForms itself needs culture data for layout/formatting. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- A RID-specific publish (dotnet publish -r win-x64) is self-contained: no .NET runtime needed on the host. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FallbackPage.html" LogicalName="SplitPlay.Tray.FallbackPage.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SplitPlay.Core\SplitPlay.Core.csproj" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control too; this app is WinForms-only and the WPF assembly
       would pull WindowsBase 5.0 against the 4.0 facade (MSB3277). -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
