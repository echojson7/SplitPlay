+/**
+ * @file src/splitplay/options.h
+ * @brief Command-line options of the SplitPlay worker (splitplay-worker.exe).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <filesystem>
+#include <ostream>
+#include <string>
+
+namespace splitplay {
+  /**
+   * @brief Options that SplitPlay.Service passes to the worker in addition to the upstream Sunshine options.
+   */
+  struct options_t {
+    std::filesystem::path desk_dir;  ///< Per-desk directory for config, state, credentials and logs. Empty: upstream default.
+    bool version = false;  ///< `--version` was given.
+    bool help = false;  ///< `--help` was given.
+    std::string error;  ///< Non-empty when the command line is invalid.
+  };
+
+  /**
+   * @brief Record the process arguments on platforms without a native wide command line.
+   * On Windows the options are read from `GetCommandLineW()`, so this call is optional there.
+   *
+   * @param argc Argument count from `main`.
+   * @param argv Argument vector from `main`.
+   */
+  void capture_command_line(int argc, char **argv);
+
+  /**
+   * @brief Options parsed from the process command line.
+   * Safe to call during static initialisation (the upstream config defaults call `platf::appdata()` before `main`).
+   *
+   * @return Parsed options, computed once.
+   */
+  const options_t &options();
+
+  /**
+   * @brief Remove the SplitPlay options from `argv` so that the upstream parser never sees them.
+   *
+   * @param argc Argument count.
+   * @param argv Argument vector, compacted in place.
+   * @return The new argument count.
+   */
+  int strip_args(int argc, char **argv);
+
+  /**
+   * @brief Product version string, e.g. `splitplay-worker 0.1.0 (SplitPlay desk worker, Sunshine cf52f4b6)`.
+   *
+   * @return Version string.
+   */
+  std::string version_string();
+
+  /**
+   * @brief Bare SplitPlay version, e.g. `0.1.0`.
+   *
+   * @return Version.
+   */
+  std::string version();
+
+  /**
+   * @brief Print the SplitPlay part of `--help`; the upstream usage follows it.
+   *
+   * @param out Output stream.
+   */
+  void print_help_header(std::ostream &out);
+
+  /**
+   * @brief Make the executable's directory the working directory so that the relative assets path resolves
+   * no matter where the service starts the worker from.
+   */
+  void use_executable_directory_as_cwd();
+}  // namespace splitplay
