+    /**
+     * @brief A Profile field (docs/contracts/ipc.md) the worker applies.
+     */
+    struct profile_field_t {
+      const char *name;  ///< Field name on the pipe.
+      int min;  ///< Smallest accepted value.
+      int max;  ///< Largest accepted value.
+      void (*set)(std::optional<int>);  ///< Setter in splitplay::profile; std::nullopt restores the default.
+      bool live;  ///< Applies to running streams (otherwise from the next stream on).
+    };
+
+    constexpr profile_field_t profile_fields[] = {
+      {"fec_percent", 0, 255, &splitplay::profile::set_fec_percent, true},
+      {"min_fps", 1, 1000, &splitplay::profile::set_min_fps, true},
+      {"pacing_mbps", 1, 100000, &splitplay::profile::set_pacing_mbps, true},
+      {"dpb_frames", 1, 16, &splitplay::profile::set_dpb_frames, false},
+    };
+
+    /**
+     * @brief Apply the stream settings of a Profile object, all or nothing.
+     *
+     * A field that is absent keeps its current value, `null` restores the built-in default. Fields the worker does
+     * not apply (the client picks mode, bitrate and codec in Moonlight) are listed in `not_applied`.
+     *
+     * @param profile The Profile object.
+     * @param origin `welcome` or `set_profile`, for the log.
+     * @param error Set when the profile is invalid; nothing is applied then.
+     * @return `{"applied":[...],"next_stream":[...],"not_applied":[...]}`, or nullopt when invalid.
+     */
+    std::optional<json> apply_profile(const json &profile, std::string_view origin, std::string &error) {
+      if (!profile.is_object()) {
+        error = "profile must be an object";
+        return std::nullopt;
+      }
+      for (const auto &field : profile_fields) {
+        const auto it = profile.find(field.name);
+        if (it == profile.end() || it->is_null()) {
+          continue;
+        }
+        if (!it->is_number_integer() || it->get<std::int64_t>() < field.min || it->get<std::int64_t>() > field.max) {
+          error = std::string {field.name} + " must be an integer from " + std::to_string(field.min) + " to " + std::to_string(field.max);
+          return std::nullopt;
+        }
+      }
+
+      json applied = json::array();
+      json next_stream = json::array();
+      json not_applied = json::array();
+      std::string summary;
+      for (const auto &field : profile_fields) {
+        const auto it = profile.find(field.name);
+        if (it == profile.end()) {
+          continue;
+        }
+        const std::optional<int> value = it->is_null() ? std::nullopt : std::optional<int> {it->get<int>()};
+        field.set(value);
+        (field.live ? applied : next_stream).push_back(field.name);
+        summary += ' ';
+        summary += field.name;
+        summary += '=';
+        summary += value ? std::to_string(*value) : std::string {"default"};
+        if (!field.live) {
+          summary += " (next stream)";
+        }
+      }
+      for (const auto &[key, value] : profile.items()) {
+        const bool known = std::any_of(std::begin(profile_fields), std::end(profile_fields), [&key](const profile_field_t &field) {
+          return key == field.name;
+        });
+        if (!known) {
+          not_applied.push_back(key);
+        }
+      }
+
+      BOOST_LOG(info) << "SplitPlay: profile from "sv << origin << ':' << (summary.empty() ? std::string {" no stream settings"} : summary)
+                      << (not_applied.empty() ? std::string {} : ", not applied by the worker: " + not_applied.dump());
+      return json {{"applied", std::move(applied)}, {"next_stream", std::move(next_stream)}, {"not_applied", std::move(not_applied)}};
+    }
+
     /**
      * @brief True once something accepts TCP connections on 127.0.0.1:port.
      */
