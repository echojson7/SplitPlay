     const double loss = total_frames > 0 ? std::min(100.0, static_cast<double>(total_lost) * 100.0 / static_cast<double>(total_frames)) : 0;
+
+    // The composition rate is measured over the same interval for the whole desk (one display per worker); without a
+    // stream nothing captures and the rate would read 0, so it is null then.
+    const auto composed_now = composed_frames.load(std::memory_order_relaxed);
+    const auto composed_at = std::chrono::steady_clock::now();
+    const double composed_seconds = std::chrono::duration<double>(composed_at - seen_composed_at).count();
+    const double capture_fps = composed_seconds > 0.05 ? static_cast<double>(composed_now - seen_composed) / composed_seconds : 0;
