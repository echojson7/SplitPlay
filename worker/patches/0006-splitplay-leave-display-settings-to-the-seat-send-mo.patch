diff --git a/src/splitplay/control_client.cpp b/src/splitplay/control_client.cpp
index 01c4e88533a34025e4556c0401c047d3c61eca33..b86eef58f7ab10f95379fb6ef16912970c26660c 100644
--- a/src/splitplay/control_client.cpp
+++ b/src/splitplay/control_client.cpp
@@ -18,6 +18,7 @@
 #include <string>
 #include <string_view>
 #include <thread>
+#include <utility>
 
 // lib includes
 #include <nlohmann/json.hpp>
@@ -192,6 +193,13 @@ namespace splitplay::control {
         BOOST_LOG(info) << "SplitPlay: ready (base port "sv << config::sunshine.port << ')';
       }
 
+      /**
+       * @brief Send `event` with `name` and `data` (child to service, no answer expected).
+       */
+      void send_event(const std::string &name, json data) {
+        send({{"type", "event"}, {"name", name}, {"data", std::move(data)}});
+      }
+
       void shutdown() {
         stopping = true;
         if (stop_event) {
@@ -461,6 +469,18 @@ namespace splitplay::control {
     };
 
     std::unique_ptr<client_t> client;
+
+    /**
+     * @brief Size of the session's primary display, {0, 0} when unknown.
+     */
+    std::pair<DWORD, DWORD> desktop_size() {
+      DEVMODEW mode {};
+      mode.dmSize = sizeof(mode);
+      if (!EnumDisplaySettingsExW(nullptr, ENUM_CURRENT_SETTINGS, &mode, 0)) {
+        return {0, 0};
+      }
+      return {mode.dmPelsWidth, mode.dmPelsHeight};
+    }
   }  // namespace
 
   int start() {
@@ -489,6 +509,33 @@ namespace splitplay::control {
     }
   }
 
+  void request_mode(int width, int height, int fps, std::chrono::milliseconds timeout) {
+    const auto before = desktop_size();
+    BOOST_LOG(info) << "SplitPlay: client requests "sv << width << 'x' << height << '@' << fps << ", desktop is "sv << before.first << 'x' << before.second;
+    if (!client) {
+      BOOST_LOG(info) << "SplitPlay: standalone, the desktop mode is left as it is"sv;
+      return;
+    }
+    client->send_event("mode_requested", {{"width", width}, {"height", height}, {"fps", fps}});
+
+    const std::pair<DWORD, DWORD> wanted {static_cast<DWORD>(width), static_cast<DWORD>(height)};
+    if (width <= 0 || height <= 0 || before == wanted) {
+      return;
+    }
+    // The seat may round the size (RDP wants an even width) or refuse it, so any change ends the wait.
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    auto now = before;
+    while (now == before && std::chrono::steady_clock::now() < deadline) {
+      std::this_thread::sleep_for(50ms);
+      now = desktop_size();
+    }
+    if (now == before) {
+      BOOST_LOG(warning) << "SplitPlay: the desktop is still "sv << now.first << 'x' << now.second << " after "sv << timeout.count() << " ms, streaming it as it is"sv;
+    } else {
+      BOOST_LOG(info) << "SplitPlay: desktop changed to "sv << now.first << 'x' << now.second;
+    }
+  }
+
   void stop() {
     client.reset();
   }
@@ -504,6 +551,9 @@ namespace splitplay::control {
   void notify_ready() {
   }
 
+  void request_mode(int, int, int, std::chrono::milliseconds) {
+  }
+
   void stop() {
   }
 #endif
