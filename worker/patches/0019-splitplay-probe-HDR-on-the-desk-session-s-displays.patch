diff --git a/src/splitplay/hdr_probe.cpp b/src/splitplay/hdr_probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c43591682d4257593dcd2b662ba7bac9d0c01f56
--- /dev/null
+++ b/src/splitplay/hdr_probe.cpp
@@ -0,0 +1,389 @@
+/**
+ * @file src/splitplay/hdr_probe.cpp
+ * @brief HDR probe of the desk session's displays.
+ *
+ * A desk's display is Microsoft's RdpIdd, the indirect display of the RDP session. Windows turns HDR on for it only
+ * when the RDP client asks for HDR over the GFX pipeline, and the seat connects without GFX, so the expected answer
+ * is `unsupported`. This file measures it instead of assuming it.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+// local includes
+#include "hdr_probe.h"
+#include "src/logging.h"
+
+#ifdef _WIN32
+  // platform includes
+  #include <windows.h>
+  #include <dxgi1_6.h>
+#endif
+
+using namespace std::literals;
+using json = nlohmann::json;
+
+namespace splitplay::hdr {
+  namespace {
+    std::mutex last_mutex;
+    std::string last = "unknown";
+
+    void remember(const json &result) {
+      std::lock_guard lg {last_mutex};
+      last = result.value("state", "unknown");
+    }
+  }  // namespace
+
+  std::string last_state() {
+    std::lock_guard lg {last_mutex};
+    return last;
+  }
+
+#ifdef _WIN32
+  namespace {
+    // The Windows 11 24H2 structures, declared here because older MinGW headers lack them (same layout and type ids
+    // as the Windows SDK's DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO_2 and DISPLAYCONFIG_SET_HDR_STATE).
+    constexpr auto get_advanced_color_info_2 = static_cast<DISPLAYCONFIG_DEVICE_INFO_TYPE>(15);
+    constexpr auto set_hdr_state = static_cast<DISPLAYCONFIG_DEVICE_INFO_TYPE>(16);
+
+    struct advanced_color_info_2_t {
+      DISPLAYCONFIG_DEVICE_INFO_HEADER header;
+      UINT32 value;  ///< Bit 0 advancedColorSupported, 1 advancedColorActive, 3 advancedColorLimitedByPolicy,
+                     ///< 4 highDynamicRangeSupported, 5 highDynamicRangeUserEnabled, 6 wideColorSupported, 7 wideColorUserEnabled.
+      UINT32 colorEncoding;
+      UINT32 bitsPerColorChannel;
+      UINT32 activeColorMode;  ///< 0 SDR, 1 WCG, 2 HDR.
+    };
+
+    struct set_hdr_state_t {
+      DISPLAYCONFIG_DEVICE_INFO_HEADER header;
+      UINT32 value;  ///< Bit 0 enableHdr.
+    };
+
+    constexpr bool bit(UINT32 value, int n) {
+      return (value >> n) & 1u;
+    }
+
+    std::string to_utf8(const wchar_t *text) {
+      if (!text || !*text) {
+        return {};
+      }
+      const int size = WideCharToMultiByte(CP_UTF8, 0, text, -1, nullptr, 0, nullptr, nullptr);
+      if (size <= 1) {
+        return {};
+      }
+      std::string out(static_cast<std::size_t>(size - 1), '\0');
+      WideCharToMultiByte(CP_UTF8, 0, text, -1, out.data(), size, nullptr, nullptr);
+      return out;
+    }
+
+    template<class T>
+    struct com_t {
+      T *p = nullptr;
+
+      ~com_t() {
+        if (p) {
+          p->Release();
+        }
+      }
+
+      T **put() {
+        if (p) {
+          p->Release();
+          p = nullptr;
+        }
+        return &p;
+      }
+    };
+
+    /**
+     * @brief One display of the session: what DXGI and the Display Configuration API say about it.
+     */
+    struct display_t {
+      std::string name;  ///< GDI device name, e.g. \\.\DISPLAY1: the key both sources share.
+      json monitor = nullptr;
+      json adapter = nullptr;
+      json hdr_supported = nullptr;
+      json hdr_enabled = nullptr;
+      json limited_by_policy = nullptr;
+      json color_mode = nullptr;
+      json bits_per_color = nullptr;
+      json dxgi_hdr = nullptr;
+      json max_nits = nullptr;
+      bool has_path = false;
+      DISPLAYCONFIG_PATH_INFO path {};
+
+      json to_json() const {
+        return {
+          {"name", name},
+          {"monitor", monitor},
+          {"adapter", adapter},
+          {"hdr_supported", hdr_supported},
+          {"hdr_enabled", hdr_enabled},
+          {"limited_by_policy", limited_by_policy},
+          {"color_mode", color_mode},
+          {"bits_per_color", bits_per_color},
+          {"dxgi_hdr", dxgi_hdr},
+          {"max_nits", max_nits},
+        };
+      }
+    };
+
+    void read_dxgi(std::map<std::string, display_t> &displays) {
+      com_t<IDXGIFactory1> factory;
+      if (FAILED(CreateDXGIFactory1(IID_IDXGIFactory1, reinterpret_cast<void **>(factory.put())))) {
+        return;
+      }
+      for (UINT a = 0;; ++a) {
+        com_t<IDXGIAdapter1> adapter;
+        if (factory.p->EnumAdapters1(a, adapter.put()) == DXGI_ERROR_NOT_FOUND) {
+          break;
+        }
+        DXGI_ADAPTER_DESC1 adapter_desc {};
+        adapter.p->GetDesc1(&adapter_desc);
+        for (UINT o = 0;; ++o) {
+          com_t<IDXGIOutput> output;
+          if (adapter.p->EnumOutputs(o, output.put()) == DXGI_ERROR_NOT_FOUND) {
+            break;
+          }
+          com_t<IDXGIOutput6> output6;
+          if (FAILED(output.p->QueryInterface(IID_IDXGIOutput6, reinterpret_cast<void **>(output6.put())))) {
+            continue;
+          }
+          DXGI_OUTPUT_DESC1 desc {};
+          if (FAILED(output6.p->GetDesc1(&desc)) || !desc.AttachedToDesktop) {
+            continue;
+          }
+          auto &d = displays[to_utf8(desc.DeviceName)];
+          d.name = to_utf8(desc.DeviceName);
+          d.adapter = to_utf8(adapter_desc.Description);
+          // What Sunshine's display_base_t::is_hdr() checks: only then is a stream encoded as HDR10.
+          d.dxgi_hdr = desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+          d.max_nits = desc.MaxLuminance;
+          if (d.bits_per_color.is_null()) {
+            d.bits_per_color = desc.BitsPerColor;
+          }
+        }
+      }
+    }
+
+    /**
+     * @brief Read one path's HDR support, the Windows 11 24H2 way first, then the older advanced colour info.
+     */
+    void read_color(display_t &d) {
+      advanced_color_info_2_t info2 {};
+      info2.header.type = get_advanced_color_info_2;
+      info2.header.size = sizeof(info2);
+      info2.header.adapterId = d.path.targetInfo.adapterId;
+      info2.header.id = d.path.targetInfo.id;
+      if (DisplayConfigGetDeviceInfo(&info2.header) == ERROR_SUCCESS) {
+        d.hdr_supported = bit(info2.value, 4);
+        d.hdr_enabled = bit(info2.value, 5) && info2.activeColorMode == 2;
+        d.limited_by_policy = bit(info2.value, 3);
+        d.color_mode = info2.activeColorMode == 2 ? "hdr" : (info2.activeColorMode == 1 ? "wcg" : "sdr");
+        d.bits_per_color = info2.bitsPerColorChannel;
+        return;
+      }
+
+      DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO info {};
+      info.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO;
+      info.header.size = sizeof(info);
+      info.header.adapterId = d.path.targetInfo.adapterId;
+      info.header.id = d.path.targetInfo.id;
+      if (DisplayConfigGetDeviceInfo(&info.header) == ERROR_SUCCESS) {
+        // Before 24H2 "advanced colour" is HDR (wide colour gamut on SDR displays came with 24H2).
+        const UINT32 value = info.value;
+        d.hdr_supported = bit(value, 0) && !bit(value, 2);
+        d.hdr_enabled = bit(value, 1) && !bit(value, 2);
+        d.limited_by_policy = bit(value, 3);  // advancedColorForceDisabled
+        d.color_mode = bit(value, 1) ? (bit(value, 2) ? "wcg" : "hdr") : "sdr";
+        d.bits_per_color = info.bitsPerColorChannel;
+      }
+    }
+
+    /**
+     * @return 0, or the Win32 error of the failed call.
+     */
+    LONG read_display_config(std::map<std::string, display_t> &displays) {
+      UINT32 path_count = 0;
+      UINT32 mode_count = 0;
+      std::vector<DISPLAYCONFIG_PATH_INFO> paths;
+      std::vector<DISPLAYCONFIG_MODE_INFO> modes;
+      LONG status = ERROR_INSUFFICIENT_BUFFER;
+      for (int attempt = 0; attempt < 3 && status == ERROR_INSUFFICIENT_BUFFER; ++attempt) {
+        status = GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count);
+        if (status != ERROR_SUCCESS) {
+          return status;
+        }
+        paths.resize(path_count);
+        modes.resize(mode_count);
+        status = QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &path_count, paths.data(), &mode_count, modes.data(), nullptr);
+      }
+      if (status != ERROR_SUCCESS) {
+        return status;
+      }
+      paths.resize(path_count);
+
+      for (const auto &path : paths) {
+        DISPLAYCONFIG_SOURCE_DEVICE_NAME source {};
+        source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+        source.header.size = sizeof(source);
+        source.header.adapterId = path.sourceInfo.adapterId;
+        source.header.id = path.sourceInfo.id;
+        if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS) {
+          continue;
+        }
+        const auto name = to_utf8(source.viewGdiDeviceName);
+        auto &d = displays[name];
+        if (d.has_path) {
+          continue;  // A cloned source: the first target speaks for it.
+        }
+        d.name = name;
+        d.has_path = true;
+        d.path = path;
+
+        DISPLAYCONFIG_TARGET_DEVICE_NAME target {};
+        target.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME;
+        target.header.size = sizeof(target);
+        target.header.adapterId = path.targetInfo.adapterId;
+        target.header.id = path.targetInfo.id;
+        if (DisplayConfigGetDeviceInfo(&target.header) == ERROR_SUCCESS) {
+          d.monitor = to_utf8(target.monitorFriendlyDeviceName);
+        }
+        read_color(d);
+      }
+      return ERROR_SUCCESS;
+    }
+
+    std::map<std::string, display_t> read_all(LONG &query_error) {
+      std::map<std::string, display_t> displays;
+      read_dxgi(displays);
+      query_error = read_display_config(displays);
+      return displays;
+    }
+
+    json summarize(const std::map<std::string, display_t> &displays, LONG query_error) {
+      json list = json::array();
+      bool any_hdr = false;
+      bool any_supported = false;
+      bool any_known = false;
+      for (const auto &[name, d] : displays) {
+        list.push_back(d.to_json());
+        if (d.dxgi_hdr.is_boolean() && d.dxgi_hdr.get<bool>()) {
+          any_hdr = true;
+        }
+        if (d.hdr_supported.is_boolean()) {
+          any_known = true;
+          any_supported = any_supported || d.hdr_supported.get<bool>();
+        }
+      }
+      std::string state = "unknown";
+      if (any_hdr) {
+        state = "enabled";
+      } else if (any_supported) {
+        state = "off";
+      } else if (any_known) {
+        state = "unsupported";
+      }
+      json result {{"state", state}, {"displays", std::move(list)}};
+      if (query_error != ERROR_SUCCESS) {
+        result["query_error"] = query_error;
+      }
+      return result;
+    }
+
+    LONG set_hdr(const display_t &d, bool enable) {
+      set_hdr_state_t state {};
+      state.header.type = set_hdr_state;
+      state.header.size = sizeof(state);
+      state.header.adapterId = d.path.targetInfo.adapterId;
+      state.header.id = d.path.targetInfo.id;
+      state.value = enable ? 1u : 0u;
+      const LONG status = DisplayConfigSetDeviceInfo(&state.header);
+      if (status == ERROR_SUCCESS) {
+        return status;
+      }
+
+      DISPLAYCONFIG_SET_ADVANCED_COLOR_STATE legacy {};
+      legacy.header.type = DISPLAYCONFIG_DEVICE_INFO_SET_ADVANCED_COLOR_STATE;
+      legacy.header.size = sizeof(legacy);
+      legacy.header.adapterId = d.path.targetInfo.adapterId;
+      legacy.header.id = d.path.targetInfo.id;
+      legacy.value = enable ? 1u : 0u;
+      const LONG legacy_status = DisplayConfigSetDeviceInfo(&legacy.header);
+      // Report the 24H2 call's error when both fail: on older Windows it is ERROR_INVALID_PARAMETER (unknown type).
+      return legacy_status == ERROR_SUCCESS ? legacy_status : status;
+    }
+  }  // namespace
+
+  json probe() {
+    LONG query_error = ERROR_SUCCESS;
+    auto result = summarize(read_all(query_error), query_error);
+    remember(result);
+    return result;
+  }
+
+  json try_enable(std::chrono::milliseconds settle) {
+    LONG query_error = ERROR_SUCCESS;
+    const auto displays = read_all(query_error);
+    json result {{"before", summarize(displays, query_error)}};
+
+    json attempts = json::array();
+    std::vector<const display_t *> changed;
+    for (const auto &[name, d] : displays) {
+      if (!d.has_path || (d.dxgi_hdr.is_boolean() && d.dxgi_hdr.get<bool>())) {
+        continue;  // Not a Display Configuration path, or already in HDR.
+      }
+      const LONG status = set_hdr(d, true);
+      BOOST_LOG(info) << "SplitPlay: HDR probe: switching HDR on for "sv << name << " returned "sv << status;
+      attempts.push_back({{"name", name}, {"set_result", status}});
+      if (status == ERROR_SUCCESS) {
+        changed.push_back(&d);
+      }
+    }
+
+    if (!changed.empty()) {
+      std::this_thread::sleep_for(settle);
+    }
+    LONG after_error = ERROR_SUCCESS;
+    const auto after = read_all(after_error);
+    for (auto &attempt : attempts) {
+      const auto it = after.find(attempt["name"].get<std::string>());
+      attempt["enabled_after"] = it != after.end() ? it->second.dxgi_hdr : json(nullptr);
+    }
+    result["after"] = summarize(after, after_error);
+
+    for (const auto *d : changed) {
+      const LONG status = set_hdr(*d, false);
+      for (auto &attempt : attempts) {
+        if (attempt["name"] == d->name) {
+          attempt["restored"] = status == ERROR_SUCCESS;
+        }
+      }
+    }
+    result["attempts"] = std::move(attempts);
+    // HDR works on this desk if Windows composed a display in HDR10 once it was asked to.
+    result["ok"] = result["after"]["state"] == "enabled";
+    if (!changed.empty()) {
+      std::this_thread::sleep_for(settle);  // Let the display settle back to SDR before the self-test goes on.
+    }
+    probe();
+    return result;
+  }
+#else
+  json probe() {
+    json result {{"state", "unknown"}, {"displays", json::array()}};
+    remember(result);
+    return result;
+  }
+
+  json try_enable(std::chrono::milliseconds) {
+    return {{"before", probe()}, {"after", probe()}, {"attempts", json::array()}, {"ok", false}};
+  }
+#endif
+}  // namespace splitplay::hdr
diff --git a/src/splitplay/hdr_probe.h b/src/splitplay/hdr_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..6952b867228523fe4ff56bbdc8107d0116a1ca6e
--- /dev/null
+++ b/src/splitplay/hdr_probe.h
@@ -0,0 +1,48 @@
+/**
+ * @file src/splitplay/hdr_probe.h
+ * @brief HDR probe of the desk session's displays (state for the service, active check for the self-test).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <chrono>
+#include <string>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+namespace splitplay::hdr {
+  /**
+   * @brief Read the HDR state of every display this session sees. Changes nothing.
+   *
+   * DXGI gives each output's colour space (HDR10 when Windows composes it in HDR, which is what Sunshine's capture
+   * checks), the Display Configuration API whether the display supports HDR at all and whether it is switched on.
+   * Takes a few milliseconds. The result:
+   *
+   * ```json
+   * {"state":"unsupported","displays":[{"name":"\\\\.\\DISPLAY1","monitor":"","adapter":"NVIDIA GeForce RTX 5070",
+   *   "hdr_supported":false,"hdr_enabled":false,"limited_by_policy":false,"color_mode":"sdr","bits_per_color":8,
+   *   "dxgi_hdr":false,"max_nits":270.0}]}
+   * ```
+   *
+   * `state` is `enabled` (a display composes in HDR10, a stream can be HDR), `off` (a display supports HDR but it is
+   * off), `unsupported` (no display supports HDR) or `unknown` (nothing could be read). Fields a source could not
+   * provide are `null`; `query_error` names a failed Display Configuration call.
+   */
+  nlohmann::json probe();
+
+  /**
+   * @brief Try to switch HDR on for every display that is not in HDR, then put each one back.
+   *
+   * For the self-test only: the desk's picture flickers while HDR is switched. Each display gets `set_result` (the
+   * Win32 error of DisplayConfigSetDeviceInfo, 0 on success), `enabled_after` (the probe `settle` later) and
+   * `restored`. The result also carries `before` and `after` (both probe()).
+   */
+  nlohmann::json try_enable(std::chrono::milliseconds settle);
+
+  /**
+   * @brief The `state` of the last probe() on this process ("unknown" before the first one).
+   */
+  std::string last_state();
+}  // namespace splitplay::hdr
