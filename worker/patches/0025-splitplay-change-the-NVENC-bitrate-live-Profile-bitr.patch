    */
   void set_capture_mode(std::optional<capture_mode_e> value);
 
+  /**
+   * @brief Cap on one stream's video traffic in kbit/s, FEC parity included, 1-1000000. 0 or std::nullopt: no cap (the
+   *        bitrate the client asked for). The service lowers it when the network loses packets it cannot recover.
+   * @param value New value or std::nullopt.
+   */
