+/**
+ * @file src/splitplay/rdp_input.h
+ * @brief Keyboard and mouse through the seat's RDP connection (the Profile's `input`, docs/contracts/ipc.md).
+ *
+ * With `input: "rdp"` the worker writes keyboard and mouse events into the desk's input ring
+ * (`Global\SplitPlay.InputRing.<desk>`, the MIT contract splitplay/input_ring.h) instead of calling SendInput. The
+ * seat sends them into the session as RDP input PDUs over its loopback connection: the session sees a real remote
+ * keyboard and mouse (no "injected" flag), UAC prompts and Ctrl+Alt+Del work.
+ *
+ * - Relative motion goes over RDP only when the server accepts relative mouse PDUs (the ring's
+ *   SP_INPUT_RING_REL_MOUSE); otherwise it stays on SendInput, and so do clicks and wheel while the pointer moves that
+ *   way (an RDP pointer PDU carries a position, which would pull the cursor back). X buttons and the horizontal wheel
+ *   go over RDP only when the server announced them (SP_INPUT_RING_XBUTTONS, SP_INPUT_RING_HWHEEL).
+ * - Whenever the ring is not usable (no seat, the seat's connection is down, the seat died, the ring is full) the
+ *   event goes to SendInput as before, so input never stops.
+ * - Touch, pen and gamepads are unchanged.
+ *
+ * Threads: every `try_*` function runs on the input thread (`input_pool`), the ring's only producer. poll() runs on
+ * the heartbeat thread: it opens the ring and checks that the seat is alive, so the input thread makes no system
+ * call besides SetEvent.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace splitplay::rdp_input {
+  /// Where keyboard and mouse input goes.
+  enum class sink_e {
+    windows,  ///< SendInput, upstream (default).
+    rdp,  ///< The seat's RDP connection, through the input ring.
+  };
+
+  /**
+   * @brief Set the sink; std::nullopt: sink_e::windows. Live. Leaving `rdp` releases what is held over RDP.
+   * @param value New sink or std::nullopt.
+   */
+  void set_sink(std::optional<sink_e> value);
+
+  /**
+   * @return The configured sink.
+   */
+  sink_e sink();
+
+  /**
+   * @brief Heartbeat thread, about once a second: open the ring, check the seat. Cheap when nothing changed.
+   * @return The metric `input`: `windows`, `rdp` (all keyboard and mouse input over RDP), `rdp_mixed` (relative
+   * motion stays on SendInput: the server has no relative mouse PDUs) or `rdp_unavailable` (the seat's ring is not
+   * usable, everything goes to SendInput).
+   */
+  std::string poll();
+
+  /**
+   * @return Events that fell back to SendInput because the ring was full.
+   */
+  std::uint64_t ring_full_fallbacks();
+
+  // Input thread. Each returns true when the event went into the ring; false: the caller uses SendInput.
+
+  /**
+   * @param scancode Set-1 scancode (without prefix).
+   * @param extended E0 prefix.
+   * @param e1 E1 prefix (Pause).
+   * @param release Key up.
+   */
+  bool try_key(std::uint16_t scancode, bool extended, bool e1, bool release);
+
+  /**
+   * @brief Text as UTF-16, all key-downs then all key-ups (upstream's order).
+   * @param text UTF-16 code units.
+   * @param count Number of code units.
+   */
+  bool try_unicode(const wchar_t *text, int count);
+
+  /**
+   * @param x Horizontal position in desktop pixels (0 = left edge of the session's desktop).
+   * @param y Vertical position.
+   */
+  bool try_mouse_abs(int x, int y);
+
+  bool try_mouse_rel(int dx, int dy);
+
+  /**
+   * @param button Sunshine's numbering: 1 left, 2 middle, 3 right, 4 X1, 5 X2.
+   * @param release Button up.
+   */
+  bool try_button(int button, bool release);
+
+  /**
+   * @param delta Wheel delta, 120 per notch.
+   * @param horizontal Horizontal wheel (positive = right).
+   */
+  bool try_wheel(int delta, bool horizontal);
+}  // namespace splitplay::rdp_input
