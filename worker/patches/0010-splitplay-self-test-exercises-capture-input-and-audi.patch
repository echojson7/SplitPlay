@@ -0,0 +1,22 @@
+/**
+ * @file src/splitplay/self_test.h
+ * @brief In-session self-test of the SplitPlay worker (`--self-test <seconds>`).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+namespace splitplay::self_test {
+  /**
+   * @brief Exercise the desk session the way a stream does, without a Moonlight client.
+   *
+   * Must run after platf::init(), input::init() and video::probe_encoders(). For `seconds` it captures the
+   * session's display with the encoder's capture path (DXGI Desktop Duplication), moves the mouse with
+   * SendInput (so that the cursor, drawn from the DDA pointer shape, changes the picture) and reads the
+   * session's default render endpoint through WASAPI loopback. The result is logged and written to
+   * `<desk-dir>/self-test.json`.
+   *
+   * @param seconds Duration of the capture.
+   * @return Process exit code: 0 when frames were captured, 1 otherwise.
+   */
+  int run(int seconds);
+}  // namespace splitplay::self_test
