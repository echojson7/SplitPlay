     constexpr std::size_t max_pending_events = 64;
   }  // namespace
 
+  namespace {
+    /// Stages of frame_timing_t, in the order the heartbeat reports them.
+    enum stage_e : std::size_t {
+      stage_capture,
+      stage_encode,
+      stage_queue,
+      stage_send,
+      stage_total,
+      stage_count,
+    };
+
+    /// Heartbeat key prefix of each stage (`<prefix>_ms_p50`, `<prefix>_ms_p99`).
+    constexpr std::array<const char *, stage_count> stage_keys {"capture", "encoder", "queue", "send", "sent"};
+
+    /// Frame timing of one heartbeat interval (frame_timing()); samples beyond max_samples are dropped.
+    struct timing_window_t {
+      std::array<std::array<std::uint16_t, max_samples>, stage_count> stage {};  ///< 0.1 ms units.
+      std::array<std::size_t, stage_count> count {};
+      std::uint64_t frames = 0;
+      std::uint64_t bytes = 0;
+      std::uint64_t max_bytes = 0;
+      std::uint64_t key_frames = 0;
+      std::uint64_t key_max_bytes = 0;
+      std::uint64_t repeated = 0;
+
+      void add(stage_e s, std::optional<std::uint32_t> us) {
+        if (us && count[s] < max_samples) {
+          stage[s][count[s]++] = static_cast<std::uint16_t>(std::min<std::uint32_t>((*us + 50) / 100, std::numeric_limits<std::uint16_t>::max()));
+        }
+      }
+
+      std::vector<std::uint16_t> samples(stage_e s) const {
+        return {stage[s].begin(), stage[s].begin() + static_cast<std::ptrdiff_t>(count[s])};
+      }
+    };
+  }  // namespace
