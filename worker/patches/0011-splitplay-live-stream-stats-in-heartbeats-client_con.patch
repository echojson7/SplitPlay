diff --git a/src/splitplay/live_stats.cpp b/src/splitplay/live_stats.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7e1d22163ecab27da08c4392802bc605ae2a04e5
--- /dev/null
+++ b/src/splitplay/live_stats.cpp
@@ -0,0 +1,331 @@
+/**
+ * @file src/splitplay/live_stats.cpp
+ * @brief Live stream statistics for the SplitPlay heartbeat (docs/contracts/ipc.md).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstddef>
+#include <cstdio>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+// local includes
+#include "live_stats.h"
+
+using json = nlohmann::json;
+
+namespace splitplay::live_stats {
+  namespace {
+    /// Latency samples kept per heartbeat interval and stream; more than any frame rate Moonlight offers.
+    constexpr std::size_t max_samples = 1024;
+    /// A single loss report never counts more than this many frames (protects against a bogus range).
+    constexpr std::uint64_t max_lost_per_report = 1000;
+    /// Events kept for the next heartbeat; only reached without a control pipe (nobody drains the queue).
+    constexpr std::size_t max_pending_events = 64;
+  }  // namespace
+
+  class session_stats_t {
+  public:
+    explicit session_stats_t(session_info_t i):
+        info {std::move(i)} {
+    }
+
+    session_info_t info;  ///< Fixed by create(); `address` and `started_at` are set under state_mutex before registering.
+
+    std::atomic<std::uint64_t> frames {0};  ///< Video frames sent.
+    std::atomic<std::uint64_t> bytes {0};  ///< Video bytes sent (FEC and headers included).
+    std::atomic<std::uint64_t> lost {0};  ///< Frames the client reported lost.
+    std::atomic<std::int64_t> highest_lost {-1};  ///< Last frame index already counted as lost.
+    std::atomic<std::int64_t> rtt_ms {-1};  ///< ENet round-trip time, -1 until the control peer is connected.
+
+    std::mutex samples_mutex;
+    std::array<std::uint16_t, max_samples> samples {};  ///< Capture-to-send latencies, 0.1 ms units.
+    std::size_t sample_count = 0;
+
+    // Guarded by state_mutex.
+    bool running = false;  ///< started() was called.
+    bool peer = false;  ///< The control stream's ENet peer connected.
+    bool finished = false;  ///< ended() was called; the stream is never registered afterwards.
+    bool registered = false;  ///< Listed in heartbeats; client_connected queued.
+    std::uint64_t seen_frames = 0;
+    std::uint64_t seen_bytes = 0;
+    std::uint64_t seen_lost = 0;
+    std::chrono::steady_clock::time_point seen_at {};
+  };
+
+  namespace {
+    /// Serialises report_heartbeat() so that queued events and heartbeats leave in order. Taken by the heartbeat
+    /// thread only, before state_mutex; never by a streaming or RTSP thread.
+    std::mutex report_mutex;
+    /// Guards the registry, the event queue and the per-stream state flags. Held only for short, I/O-free work.
+    std::mutex state_mutex;
+    std::vector<std::shared_ptr<session_stats_t>> registry;  ///< Running streams, in start order.
+    std::deque<std::pair<std::string, json>> pending_events;  ///< client_connected/client_disconnected, oldest first.
+
+    double round1(double v) {
+      return std::round(v * 10.0) / 10.0;
+    }
+
+    std::string iso_time(std::chrono::system_clock::time_point tp) {
+      // Calendar arithmetic only (C++20 <chrono>): no gmtime and no platform API.
+      using namespace std::chrono;
+      const auto secs = floor<seconds>(tp);
+      const auto day = floor<days>(secs);
+      const year_month_day ymd {day};
+      const hh_mm_ss hms {secs - day};
+      char buf[32] {};
+      std::snprintf(buf, sizeof(buf), "%04d-%02u-%02uT%02d:%02d:%02dZ", static_cast<int>(ymd.year()), static_cast<unsigned>(ymd.month()), static_cast<unsigned>(ymd.day()), static_cast<int>(hms.hours().count()), static_cast<int>(hms.minutes().count()), static_cast<int>(hms.seconds().count()));
+      return buf;
+    }
+
+    json optional_string(const std::optional<std::string> &v) {
+      return v && !v->empty() ? json(*v) : json(nullptr);
+    }
+
+    json info_json(const session_info_t &info) {
+      return {
+        {"id", info.id},
+        {"client", optional_string(info.client)},
+        {"client_uuid", optional_string(info.client_uuid)},
+        {"address", info.address},
+        {"width", info.width},
+        {"height", info.height},
+        {"fps_requested", info.fps_requested},
+        {"codec", info.codec},
+        {"bitrate_kbps_requested", info.bitrate_kbps_requested},
+        {"hdr", info.hdr},
+        {"started_at", iso_time(info.started_at)},
+      };
+    }
+
+    /**
+     * @brief Nearest-rank percentile of samples in 0.1 ms units, in ms. Sorts `v`.
+     */
+    double percentile_ms(std::vector<std::uint16_t> &v, double q) {
+      if (v.empty()) {
+        return 0;
+      }
+      std::sort(v.begin(), v.end());
+      auto rank = static_cast<std::size_t>(std::ceil(q * static_cast<double>(v.size())));
+      rank = std::clamp<std::size_t>(rank, 1, v.size());
+      return static_cast<double>(v[rank - 1]) / 10.0;
+    }
+
+    /// Caller holds state_mutex.
+    void queue_event(const char *name, json data) {
+      if (pending_events.size() >= max_pending_events) {
+        pending_events.pop_front();
+      }
+      pending_events.emplace_back(name, std::move(data));
+    }
+
+    /// Caller holds state_mutex. Registers the stream once it is both running and connected, unless it has ended.
+    void register_if_live(const std::shared_ptr<session_stats_t> &stats) {
+      if (!stats->running || !stats->peer || stats->finished || stats->registered) {
+        return;
+      }
+      stats->info.started_at = std::chrono::system_clock::now();
+      // Measure from here: what was sent while the client connected is not part of the first interval.
+      stats->seen_frames = stats->frames.load(std::memory_order_relaxed);
+      stats->seen_bytes = stats->bytes.load(std::memory_order_relaxed);
+      stats->seen_lost = stats->lost.load(std::memory_order_relaxed);
+      stats->seen_at = std::chrono::steady_clock::now();
+      {
+        std::lock_guard lg {stats->samples_mutex};
+        stats->sample_count = 0;
+      }
+      stats->registered = true;
+      registry.push_back(stats);
+      queue_event("client_connected", info_json(stats->info));
+    }
+  }  // namespace
+
+  std::string codec_name(int video_format) {
+    switch (video_format) {
+      case 1:
+        return "hevc";
+      case 2:
+        return "av1";
+      default:
+        return "h264";
+    }
+  }
+
+  std::shared_ptr<session_stats_t> create(session_info_t info) {
+    return std::make_shared<session_stats_t>(std::move(info));
+  }
+
+  void started(const std::shared_ptr<session_stats_t> &stats, const std::string &address) {
+    if (!stats) {
+      return;
+    }
+    std::lock_guard lg {state_mutex};
+    if (stats->running || stats->finished) {
+      // A stop that raced the start already ended the stream: never report it.
+      return;
+    }
+    // An IPv4 client on a dual-stack socket shows up as ::ffff:a.b.c.d.
+    constexpr std::string_view v4_mapped {"::ffff:"};
+    const bool mapped = address.size() > v4_mapped.size() && address.compare(0, v4_mapped.size(), v4_mapped) == 0 && address.find('.') != std::string::npos;
+    stats->info.address = mapped ? address.substr(v4_mapped.size()) : address;
+    stats->running = true;
+    register_if_live(stats);
+  }
+
+  void control_connected(const std::shared_ptr<session_stats_t> &stats) {
+    if (!stats) {
+      return;
+    }
+    std::lock_guard lg {state_mutex};
+    stats->peer = true;
+    register_if_live(stats);
+  }
+
+  void ended(const std::shared_ptr<session_stats_t> &stats) {
+    if (!stats) {
+      return;
+    }
+    std::lock_guard lg {state_mutex};
+    stats->finished = true;
+    if (!stats->registered) {
+      return;
+    }
+    stats->registered = false;
+    registry.erase(std::remove(registry.begin(), registry.end(), stats), registry.end());
+    queue_event("client_disconnected", info_json(stats->info));
+  }
+
+  void frame_sent(session_stats_t *stats, std::uint64_t wire_bytes, std::optional<std::uint16_t> latency_100us) noexcept {
+    if (!stats) {
+      return;
+    }
+    stats->frames.fetch_add(1, std::memory_order_relaxed);
+    stats->bytes.fetch_add(wire_bytes, std::memory_order_relaxed);
+    if (latency_100us) {
+      std::lock_guard lg {stats->samples_mutex};
+      if (stats->sample_count < max_samples) {
+        stats->samples[stats->sample_count++] = *latency_100us;
+      }
+    }
+  }
+
+  void frames_lost(session_stats_t *stats, std::int64_t first, std::int64_t last) noexcept {
+    // Frame indices are 32-bit on the wire; anything else is a bogus report.
+    constexpr std::int64_t max_index = std::numeric_limits<std::uint32_t>::max();
+    if (!stats || last < first || last < 0 || last > max_index) {
+      return;
+    }
+    // Reports come from the control thread only; a later range may overlap an earlier one.
+    const auto highest = stats->highest_lost.load(std::memory_order_relaxed);
+    if (last <= highest) {
+      return;
+    }
+    first = std::max(first, highest + 1);  // >= 0, so last - first cannot overflow
+    stats->highest_lost.store(last, std::memory_order_relaxed);
+    const auto count = static_cast<std::uint64_t>(last - first) + 1;
+    stats->lost.fetch_add(std::min(count, max_lost_per_report), std::memory_order_relaxed);
+  }
+
+  void loss_count(session_stats_t *stats, std::int32_t count) noexcept {
+    if (!stats || count <= 0) {
+      return;
+    }
+    stats->lost.fetch_add(std::min(static_cast<std::uint64_t>(count), max_lost_per_report), std::memory_order_relaxed);
+  }
+
+  void rtt(session_stats_t *stats, std::uint32_t rtt_ms) noexcept {
+    if (stats) {
+      stats->rtt_ms.store(rtt_ms, std::memory_order_relaxed);
+    }
+  }
+
+  void report_heartbeat(const event_sink_t &send_event, const heartbeat_sink_t &send_heartbeat) {
+    std::lock_guard order {report_mutex};
+
+    std::vector<std::pair<std::string, json>> events;
+    std::vector<std::uint16_t> pooled;
+    double max_fps = 0;
+    std::uint64_t total_kbps = 0;
+    std::uint64_t total_frames = 0;
+    std::uint64_t total_lost = 0;
+    std::int64_t max_rtt = -1;
+    json sessions = json::array();
+
+    {
+      // The events and the streams are taken in one step: every event queued so far is reflected in this
+      // heartbeat's sessions, and no later one is.
+      std::lock_guard lg {state_mutex};
+      events.assign(std::make_move_iterator(pending_events.begin()), std::make_move_iterator(pending_events.end()));
+      pending_events.clear();
+
+      const auto now = std::chrono::steady_clock::now();
+      for (const auto &s : registry) {
+        std::vector<std::uint16_t> mine;
+        {
+          std::lock_guard slg {s->samples_mutex};
+          mine.assign(s->samples.begin(), s->samples.begin() + static_cast<std::ptrdiff_t>(s->sample_count));
+          s->sample_count = 0;
+        }
+
+        const auto frames = s->frames.load(std::memory_order_relaxed);
+        const auto bytes = s->bytes.load(std::memory_order_relaxed);
+        const auto lost = s->lost.load(std::memory_order_relaxed);
+        const auto rtt_ms = s->rtt_ms.load(std::memory_order_relaxed);
+
+        const auto d_frames = frames - s->seen_frames;
+        const auto d_bytes = bytes - s->seen_bytes;
+        const auto d_lost = lost - s->seen_lost;
+        const double seconds = std::chrono::duration<double>(now - s->seen_at).count();
+        s->seen_frames = frames;
+        s->seen_bytes = bytes;
+        s->seen_lost = lost;
+        s->seen_at = now;
+
+        const double fps = seconds > 0.05 ? static_cast<double>(d_frames) / seconds : 0;
+        const auto kbps = seconds > 0.05 ? static_cast<std::uint64_t>(static_cast<double>(d_bytes) * 8 / 1000 / seconds) : 0;
+        const double loss = d_frames > 0 ? std::min(100.0, static_cast<double>(d_lost) * 100.0 / static_cast<double>(d_frames)) : 0;
+
+        json entry = info_json(s->info);
+        entry["fps"] = round1(fps);
+        entry["bitrate_kbps"] = kbps;
+        entry["loss_pct"] = round1(loss);
+        entry["rtt_ms"] = rtt_ms >= 0 ? json(rtt_ms) : json(nullptr);
+        pooled.insert(pooled.end(), mine.begin(), mine.end());
+        entry["encode_ms_p50"] = percentile_ms(mine, 0.50);
+        entry["encode_ms_p99"] = percentile_ms(mine, 0.99);
+        sessions.push_back(std::move(entry));
+
+        max_fps = std::max(max_fps, fps);
+        total_kbps += kbps;
+        total_frames += d_frames;
+        total_lost += d_lost;
+        max_rtt = std::max(max_rtt, rtt_ms);
+      }
+    }
+
+    const double loss = total_frames > 0 ? std::min(100.0, static_cast<double>(total_lost) * 100.0 / static_cast<double>(total_frames)) : 0;
+    json metrics {
+      {"fps", round1(max_fps)},
+      {"bitrate_kbps", total_kbps},
+      {"encode_ms_p50", percentile_ms(pooled, 0.50)},
+      {"encode_ms_p99", percentile_ms(pooled, 0.99)},
+      {"loss_pct", round1(loss)},
+      {"rtt_ms", max_rtt >= 0 ? json(max_rtt) : json(nullptr)},
+      {"clients", sessions.size()},
+    };
+
+    // Pipe I/O happens here, on the heartbeat thread, outside state_mutex: events first, then the heartbeat.
+    for (auto &[name, data] : events) {
+      send_event(name, data);
+    }
+    send_heartbeat(std::move(metrics), std::move(sessions));
+  }
