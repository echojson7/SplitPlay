+    /**
+     * The upstream `sunshine_name=<value>` setting as given on the command line, in UTF-8 (the last one wins, an empty
+     * value is ignored, as upstream does). Sunshine's own parser reads the narrow `argv`, which Windows passes in the
+     * ANSI code page, so a desk name outside that code page would reach Moonlight garbled; `main` applies this value
+     * after the upstream parser instead. The setting stays in `argv` and is not removed by strip_args().
+     */
+    std::optional<std::string> sunshine_name;
   };
 
