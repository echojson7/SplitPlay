     std::mutex samples_mutex;
     std::array<std::uint16_t, max_samples> samples {};  ///< Capture-to-send latencies, 0.1 ms units.
     std::size_t sample_count = 0;
+    timing_window_t timing;  ///< Stage times and frame sizes of the interval; guarded by samples_mutex.
 
     // Guarded by state_mutex.
     bool running = false;  ///< started() was called.
@@ -165,6 +203,58 @@ namespace splitplay::live_stats {
       return static_cast<double>(v[rank - 1]) / 10.0;
     }
 
+    /// Frame timing of several streams (the heartbeat's `metrics`): stage samples pooled, sizes summed.
+    struct timing_pool_t {
+      std::array<std::vector<std::uint16_t>, stage_count> stage;
+      std::uint64_t frames = 0;
+      std::uint64_t bytes = 0;
+      std::uint64_t max_bytes = 0;
+      std::uint64_t key_frames = 0;
+      std::uint64_t key_max_bytes = 0;
+      std::uint64_t repeated = 0;
+
+      timing_pool_t() = default;
+
+      explicit timing_pool_t(const timing_window_t &w) {
+        merge(w);
+      }
+
+      void merge(const timing_window_t &w) {
+        for (std::size_t i = 0; i < stage_count; ++i) {
+          const auto more = w.samples(static_cast<stage_e>(i));
+          stage[i].insert(stage[i].end(), more.begin(), more.end());
+        }
+        frames += w.frames;
+        bytes += w.bytes;
+        max_bytes = std::max(max_bytes, w.max_bytes);
+        key_frames += w.key_frames;
+        key_max_bytes = std::max(key_max_bytes, w.key_max_bytes);
+        repeated += w.repeated;
+      }
+    };
+
+    /// Stage percentiles (null without samples) and frame sizes of `pool`, added to a heartbeat object.
+    void add_timing(json &out, timing_pool_t pool) {
+      for (std::size_t i = 0; i < stage_count; ++i) {
+        auto &v = pool.stage[i];
+        const std::string key = stage_keys[i];
+        out[key + "_ms_p50"] = v.empty() ? json(nullptr) : json(percentile_ms(v, 0.50));
+        out[key + "_ms_p99"] = v.empty() ? json(nullptr) : json(percentile_ms(v, 0.99));
+      }
+      // The worst frame of the interval end to end (percentile_ms sorted the samples).
+      const auto &total = pool.stage[stage_total];
+      out["sent_ms_max"] = total.empty() ? json(nullptr) : json(static_cast<double>(total.back()) / 10.0);
+      out["frame_kb_avg"] = pool.frames > 0 ? json(round1(static_cast<double>(pool.bytes) / 1024.0 / static_cast<double>(pool.frames))) : json(nullptr);
+      out["frame_kb_max"] = pool.frames > 0 ? json(round1(static_cast<double>(pool.max_bytes) / 1024.0)) : json(nullptr);
+      out["key_frames"] = pool.key_frames;
+      out["key_frame_kb_max"] = pool.key_frames > 0 ? json(round1(static_cast<double>(pool.key_max_bytes) / 1024.0)) : json(nullptr);
+      out["repeated_frames"] = pool.repeated;
+    }
+
+    void add_timing(json &out, const timing_window_t &w) {
+      add_timing(out, timing_pool_t {w});
+    }
+
     /// Caller holds state_mutex.
     void queue_event(const char *name, json data) {
       if (pending_events.size() >= max_pending_events) {
@@ -197,6 +287,7 @@ namespace splitplay::live_stats {
       {
         std::lock_guard lg {stats->samples_mutex};
         stats->sample_count = 0;
+        stats->timing = {};
