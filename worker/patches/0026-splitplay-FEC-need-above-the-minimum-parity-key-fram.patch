index 407334f266da270c1fb70c3b89d72c24a53bbb9a..34e9b02c0503558bbfc438c551e507cfe31aa5cd 100644
--- a/src/splitplay/live_stats.h
+++ b/src/splitplay/live_stats.h
@@ -46,6 +46,7 @@ namespace splitplay::live_stats {
     int bitrate_kbps_requested = 0;  ///< Bitrate the client asked for (its configured bitrate when it sends one).
     bool hdr = false;  ///< The client asked for a 10-bit HDR stream.
     bool fec_feedback = false;  ///< The client announced ML_FF_FEC_STATUS: it reports every FEC block that lost packets.
+    int min_fec_packets = 0;  ///< Parity shards every FEC block gets at least (the client's minRequiredFecPackets).
     std::chrono::system_clock::time_point started_at;  ///< When the stream was first reported.
   };
 
@@ -126,6 +127,10 @@ namespace splitplay::live_stats {
    * @brief One FEC report from the client (control thread). A block the client recovered counts the packets missing
    *        below the highest one received (later ones may only be late); a block it could not recover counts every
    *        packet it did not receive. Relaxed atomic adds and one atomic max, never a lock.
+   *
+   *        The block's FEC need (the heartbeat's `burst_loss_pct`) is only taken from blocks that lost more packets
+   *        than the minimum parity every block gets anyway (`session_info_t::min_fec_packets`): a small frame that
+   *        lost one packet out of five needs no FEC share at all, not 20 %.
    */
   void fec_status(session_stats_t *stats, const fec_status_t &status) noexcept;
 
@@ -135,6 +140,14 @@ namespace splitplay::live_stats {
    */
   void frames_lost(session_stats_t *stats, std::int64_t first, std::int64_t last) noexcept;
 
+  /**
+   * @brief The client asked for a key frame (`IDX_REQUEST_IDR_FRAME`): it threw frames away and waits for an IDR frame
+   *        to show a picture again. Moonlight does that when its decoder falls behind (the decode queue overflowed),
+   *        when the decoder failed, and after losses it could not repair by reference frame invalidation. Those frames
+   *        are lost in Moonlight's own count ("slow connection to PC") although `loss_pct` does not see them.
+   */
+  void idr_requested(session_stats_t *stats) noexcept;
+
   /**
    * @brief Loss count from a legacy loss-stats message (`IDX_LOSS_STATS`).
    */
@@ -167,7 +180,8 @@ namespace splitplay::live_stats {
    * @param send_heartbeat Receives `metrics` (`fps`, `bitrate_kbps`, `encode_ms_p50`, `encode_ms_p99`, `loss_pct`,
    *                       `rtt_ms` (null when no stream has one yet), `clients`, `capture_fps` (null without a
    *                       stream), `packet_loss_pct`, `burst_loss_pct`, `fec_recovered`, `fec_failed`, `fec_percent`,
-   *                       `encoder_kbps` (null without a stream or a live-bitrate encoder)) and the `sessions` array.
+   *                       `idr_requests` (since the streams started), `frame_gap_ms_max`, `encoder_kbps` (null
+   *                       without a stream or a live-bitrate encoder)) and the `sessions` array.
    */
   void report_heartbeat(const event_sink_t &send_event, const heartbeat_sink_t &send_heartbeat);
 }  // namespace splitplay::live_stats
