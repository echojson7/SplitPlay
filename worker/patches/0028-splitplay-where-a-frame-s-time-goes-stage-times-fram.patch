+  /**
+   * @brief Where one frame's time went on the host, from the moment the game's picture was presented to the moment
+   *        its last packet left. Each stage is in microseconds; empty when a timestamp is missing (a repeated frame
+   *        has no present time, an encoder that does not stamp its packets has no encode times).
+   */
+  struct frame_timing_t {
+    std::optional<std::uint32_t> capture_us;  ///< Present to encode start: Desktop Duplication, copy, capture queue, colour conversion submit.
+    std::optional<std::uint32_t> encode_us;  ///< Encode start to the bitstream ready: conversion on the GPU and the encoder itself.
+    std::optional<std::uint32_t> queue_us;  ///< Bitstream ready to the video broadcast thread taking it.
+    std::uint32_t send_us = 0;  ///< Packetising, FEC, encryption and paced sending, up to the last packet handed to the socket.
+    std::optional<std::uint32_t> total_us;  ///< Present to the last packet sent.
+    std::uint64_t frame_bytes = 0;  ///< Encoded frame size (before packet headers and FEC).
+    bool key_frame = false;  ///< An IDR frame.
+    bool repeated = false;  ///< Sent without new content (no capture timestamp: the idle rate, or an IDR on a static picture).
+  };
+
+  /**
+   * @brief Timing and size of one frame sent (video broadcast thread, right after frame_sent()). One short
+   *        uncontended lock.
+   */
+  void frame_timing(session_stats_t *stats, const frame_timing_t &timing) noexcept;
+
   /// Control message type of the client's per-frame FEC report (`SS_FRAME_FEC_PTYPE`, moonlight-common-c Video.h).
   constexpr std::uint16_t fec_status_packet_type = 0x5502;
 
@@ -184,7 +206,10 @@ namespace splitplay::live_stats {
    *                       `rtt_ms` (null when no stream has one yet), `clients`, `capture_fps` (null without a
    *                       stream), `packet_loss_pct`, `burst_loss_pct`, `fec_recovered`, `fec_failed`, `fec_percent`,
    *                       `idr_requests` (since the streams started), `frame_gap_ms_max`, `encoder_kbps` (null
-   *                       without a stream or a live-bitrate encoder)) and the `sessions` array.
+   *                       without a stream or a live-bitrate encoder), the stage times `capture_ms_*`,
+   *                       `encoder_ms_*`, `queue_ms_*`, `send_ms_*`, `sent_ms_*` (p50 and p99), `sent_ms_max`, `frame_kb_avg`,
+   *                       `frame_kb_max`, `key_frames`, `key_frame_kb_max`, `repeated_frames`) and the `sessions`
+   *                       array.
    */
   void report_heartbeat(const event_sink_t &send_event, const heartbeat_sink_t &send_heartbeat);
 }  // namespace splitplay::live_stats
