+  std::optional<fec_status_t> parse_fec_status(std::string_view payload) noexcept {
+    // SS_FRAME_FEC_STATUS (packed): frameIndex u32, highestReceivedSequenceNumber u16, nextContiguousSequenceNumber u16,
+    // missingPacketsBeforeHighestReceived u16, totalDataPackets u16, totalParityPackets u16, receivedDataPackets u16,
+    // receivedParityPackets u16, fecPercentage u8, multiFecBlockIndex u8, multiFecBlockCount u8. Big-endian.
+    constexpr std::size_t size = 21;
+    if (payload.size() < size) {
+      return std::nullopt;
+    }
+    const char *p = payload.data();
+    fec_status_t s;
+    s.frame_index = big32(p);
+    s.missing_before_highest = big16(p + 8);
+    s.data_packets = big16(p + 10);
+    s.parity_packets = big16(p + 12);
+    s.received_data = big16(p + 14);
+    s.received_parity = big16(p + 16);
+    s.fec_percent = static_cast<std::uint8_t>(p[18]);
+    if (s.data_packets == 0) {
+      return std::nullopt;
+    }
+    return s;
+  }
+
+  void fec_status(session_stats_t *stats, const fec_status_t &status) noexcept {
+    if (!stats || status.data_packets == 0) {
+      return;
+    }
+    const std::uint32_t total = std::uint32_t {status.data_packets} + status.parity_packets;
+    const std::uint32_t received = std::min<std::uint32_t>(total, std::uint32_t {status.received_data} + status.received_parity);
+    const bool recovered = received >= status.data_packets;
+    // A recovered block: packets after the highest one received may simply not have arrived yet, so only the gaps
+    // below it count. A block given up on: the client moved on to the next frame, so whatever did not come is lost.
+    const std::uint32_t missing = recovered ? std::min<std::uint32_t>(status.missing_before_highest, total) : total - received;
+    if (missing == 0) {
+      return;
+    }
+    stats->fec_missing.fetch_add(missing, std::memory_order_relaxed);
+    (recovered ? stats->fec_recovered : stats->fec_failed).fetch_add(1, std::memory_order_relaxed);
+
+    // The FEC share this block would have needed: lost packets per data shard (at most 65.535 times the data).
+    const auto permille = static_cast<std::uint32_t>(std::min<std::uint64_t>(std::uint64_t {missing} * 1000 / status.data_packets, 65535));
+    auto worst = stats->burst_permille.load(std::memory_order_relaxed);
+    while (permille > worst && !stats->burst_permille.compare_exchange_weak(worst, permille, std::memory_order_relaxed)) {
+    }
+  }
