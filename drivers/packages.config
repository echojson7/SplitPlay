<!-- WDK and SDK from NuGet (learn.microsoft.com: "Install the WDK using NuGet").
     Restore with: nuget restore drivers\packages.config -PackagesDirectory drivers\packages
     Keep the version in sync with SplitPlayWdkVersion in Directory.Build.props.
     10.0.26100.x matches the WDK Visual Studio component (10.0.26100.*) of Visual Studio 2022 17.14. -->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.26100.6584" targetFramework="native" />
</packages>
