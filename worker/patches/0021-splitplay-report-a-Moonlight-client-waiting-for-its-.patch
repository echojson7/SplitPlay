diff --git a/src/splitplay/pairing.cpp b/src/splitplay/pairing.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6f8c1706626bb1eb9d19dafadeadd24925095950
--- /dev/null
+++ b/src/splitplay/pairing.cpp
@@ -0,0 +1,72 @@
+/**
+ * @file src/splitplay/pairing.cpp
+ * @brief A Moonlight client waiting for its PIN, reported in the SplitPlay heartbeat (docs/contracts/ipc.md).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <cstdio>
+#include <map>
+#include <mutex>
+
+// local includes
+#include "pairing.h"
+
+using json = nlohmann::json;
+
+namespace splitplay::pairing {
+  namespace {
+    struct request_t {
+      std::string address;
+      std::chrono::system_clock::time_point since;  ///< Reported to the service.
+      std::chrono::steady_clock::time_point started;  ///< Ages the request; immune to clock changes.
+    };
+
+    std::mutex requests_mutex;
+    std::map<std::string, request_t> requests;  ///< Waiting requests by pairing session key.
+
+    std::string iso_time(std::chrono::system_clock::time_point tp) {
+      // Calendar arithmetic only (C++20 <chrono>): no gmtime and no platform API.
+      using namespace std::chrono;
+      const auto secs = floor<seconds>(tp);
+      const auto day = floor<days>(secs);
+      const year_month_day ymd {day};
+      const hh_mm_ss hms {secs - day};
+      char buf[32] {};
+      std::snprintf(buf, sizeof(buf), "%04d-%02u-%02uT%02d:%02d:%02dZ", static_cast<int>(ymd.year()), static_cast<unsigned>(ymd.month()), static_cast<unsigned>(ymd.day()), static_cast<int>(hms.hours().count()), static_cast<int>(hms.minutes().count()), static_cast<int>(hms.seconds().count()));
+      return buf;
+    }
+  }  // namespace
+
+  void requested(const std::string &unique_id, const std::string &address) {
+    std::lock_guard lk {requests_mutex};
+    requests[unique_id] = request_t {address, std::chrono::system_clock::now(), std::chrono::steady_clock::now()};
+  }
+
+  void answered(const std::string &unique_id) {
+    std::lock_guard lk {requests_mutex};
+    requests.erase(unique_id);
+  }
+
+  json report() {
+    std::lock_guard lk {requests_mutex};
+    const auto now = std::chrono::steady_clock::now();
+    const request_t *newest = nullptr;
+    for (auto it = requests.begin(); it != requests.end();) {
+      if (now - it->second.started >= request_lifetime) {
+        it = requests.erase(it);
+        continue;
+      }
+      if (newest == nullptr || it->second.started > newest->started) {
+        newest = &it->second;
+      }
+      ++it;
+    }
+    if (newest == nullptr) {
+      return nullptr;
+    }
+    return {
+      {"address", newest->address},
+      {"since", iso_time(newest->since)},
+    };
+  }
+}  // namespace splitplay::pairing
diff --git a/src/splitplay/pairing.h b/src/splitplay/pairing.h
new file mode 100644
index 0000000000000000000000000000000000000000..52738b46fc88715027def5b28f5a299a2b113323
--- /dev/null
+++ b/src/splitplay/pairing.h
@@ -0,0 +1,47 @@
+/**
+ * @file src/splitplay/pairing.h
+ * @brief A Moonlight client waiting for its PIN, reported in the SplitPlay heartbeat (docs/contracts/ipc.md,
+ *        `pairing`).
+ *
+ * Moonlight starts pairing with `getservercert` and keeps that request open until the host user types the PIN the
+ * client shows. Sunshine parks the request and waits for `nvhttp::pin()`. The HTTP thread marks the request here; the
+ * heartbeat thread reports it, so the SplitPlay service can ask for the PIN in one place and the tray can say so.
+ * The mark goes when the PIN is handed over, when the pairing session is removed (finished, failed or replaced) and,
+ * as a last resort, after `request_lifetime`: Sunshine never notices a client that gave up and closed the request.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <chrono>
+#include <string>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+namespace splitplay::pairing {
+  /// A request nobody answered for this long is no longer reported (the client gave up long before).
+  constexpr std::chrono::minutes request_lifetime {5};
+
+  /**
+   * @brief A client asked for the server certificate and waits for the PIN (HTTP thread). A second request with the
+   *        same id replaces the first one and starts its wait again.
+   *
+   * @param unique_id Pairing session key (the client's `uniqueid`).
+   * @param address Client IP address, IPv4-mapped IPv6 addresses as plain IPv4.
+   */
+  void requested(const std::string &unique_id, const std::string &address);
+
+  /**
+   * @brief The pairing session no longer waits for a PIN: the PIN was handed over, or the session was removed.
+   *        Unknown ids are ignored.
+   */
+  void answered(const std::string &unique_id);
+
+  /**
+   * @brief The heartbeat's `pairing` value: null while no client waits, otherwise the newest waiting request as
+   *        `{"address":"192.168.1.37","since":"2026-11-06T21:00:00Z"}`. Drops requests older than
+   *        `request_lifetime`.
+   */
+  nlohmann::json report();
+}  // namespace splitplay::pairing
