diff --git a/src/splitplay/doorbell.cpp b/src/splitplay/doorbell.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..512ed0afec200fe10f0d8cc0a31fdcc3f79c9eac
--- /dev/null
+++ b/src/splitplay/doorbell.cpp
@@ -0,0 +1,141 @@
+/**
+ * @file src/splitplay/doorbell.cpp
+ * @brief Wakes the control stream thread for queued feedback (see doorbell.h).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <random>
+
+// local includes
+#include "doorbell.h"
+#include "src/logging.h"
+
+#ifdef _WIN32
+  // platform includes
+  #include <winsock2.h>
+  #include <ws2tcpip.h>
+#endif
+
+using namespace std::literals;
+
+namespace splitplay::doorbell {
+  namespace {
+    /// Written by arm() before it sets `armed`; read by ring() under the mutex and by the control thread.
+    std::array<std::uint8_t, 16> token {};
+    std::atomic_bool armed {false};
+    std::atomic_bool rung {false};  ///< A datagram is on its way and the control thread has not drained yet.
+
+#ifdef _WIN32
+    std::mutex socket_mutex;  ///< Guards the socket and the target (ring() runs on any thread).
+    SOCKET socket_handle = INVALID_SOCKET;
+    sockaddr_storage target {};
+    int target_size = 0;
+    std::string target_text;
+
+    /**
+     * @brief The address the ENet host can be reached at: its bind address, or loopback for the wildcard.
+     */
+    void resolve_target(std::uint16_t port, const std::string &bind_address, bool ipv6) {
+      target = {};
+      in_addr v4 {};
+      in6_addr v6 {};
+      if (inet_pton(AF_INET, bind_address.c_str(), &v4) == 1 && v4.s_addr != htonl(INADDR_ANY)) {
+        auto &a = reinterpret_cast<sockaddr_in &>(target);
+        a.sin_family = AF_INET;
+        a.sin_addr = v4;
+        a.sin_port = htons(port);
+        target_size = sizeof(sockaddr_in);
+        target_text = bind_address;
+      } else if (inet_pton(AF_INET6, bind_address.c_str(), &v6) == 1 && std::memcmp(&v6, &in6addr_any, sizeof(v6)) != 0) {
+        auto &a = reinterpret_cast<sockaddr_in6 &>(target);
+        a.sin6_family = AF_INET6;
+        a.sin6_addr = v6;
+        a.sin6_port = htons(port);
+        target_size = sizeof(sockaddr_in6);
+        target_text = '[' + bind_address + ']';
+      } else if (ipv6) {
+        auto &a = reinterpret_cast<sockaddr_in6 &>(target);
+        a.sin6_family = AF_INET6;
+        a.sin6_addr = in6addr_loopback;
+        a.sin6_port = htons(port);
+        target_size = sizeof(sockaddr_in6);
+        target_text = "[::1]";
+      } else {
+        auto &a = reinterpret_cast<sockaddr_in &>(target);
+        a.sin_family = AF_INET;
+        a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        a.sin_port = htons(port);
+        target_size = sizeof(sockaddr_in);
+        target_text = "127.0.0.1";
+      }
+      target_text += ':' + std::to_string(port);
+    }
+#endif
+  }  // namespace
+
+#ifdef _WIN32
+  void arm(std::uint16_t port, const std::string &bind_address, bool ipv6) {
+    std::lock_guard lg {socket_mutex};
+    if (socket_handle != INVALID_SOCKET) {
+      closesocket(socket_handle);
+      socket_handle = INVALID_SOCKET;
+    }
+    resolve_target(port, bind_address, ipv6);
+    socket_handle = ::socket(target.ss_family, SOCK_DGRAM, IPPROTO_UDP);
+    if (socket_handle == INVALID_SOCKET) {
+      BOOST_LOG(warning) << "SplitPlay: no control doorbell [error "sv << WSAGetLastError() << "], rumble waits for the control loop"sv;
+      return;
+    }
+
+    std::random_device random;
+    for (auto &byte : token) {
+      byte = static_cast<std::uint8_t>(random());
+    }
+    rung = false;
+    armed = true;
+    BOOST_LOG(info) << "SplitPlay: rumble and HDR metadata are sent at once (control doorbell to "sv << target_text << ')';
+  }
+
+  void disarm() {
+    armed = false;
+    std::lock_guard lg {socket_mutex};
+    if (socket_handle != INVALID_SOCKET) {
+      closesocket(socket_handle);
+      socket_handle = INVALID_SOCKET;
+    }
+  }
+
+  void ring() {
+    if (!armed.load(std::memory_order_acquire) || rung.exchange(true, std::memory_order_acq_rel)) {
+      return;
+    }
+    std::lock_guard lg {socket_mutex};
+    if (socket_handle == INVALID_SOCKET ||
+        sendto(socket_handle, reinterpret_cast<const char *>(token.data()), static_cast<int>(token.size()), 0, reinterpret_cast<const sockaddr *>(&target), target_size) == SOCKET_ERROR) {
+      // The control loop still drains on its own cycle; the next ring tries again.
+      rung = false;
+    }
+  }
+#else
+  void arm(std::uint16_t, const std::string &, bool) {
+  }
+
+  void disarm() {
+  }
+
+  void ring() {
+  }
+#endif
+
+  void rearm() {
+    rung.store(false, std::memory_order_release);
+  }
+
+  bool is_ring(const void *data, std::size_t size) {
+    return size == token.size() && armed.load(std::memory_order_acquire) && std::memcmp(data, token.data(), size) == 0;
+  }
+}  // namespace splitplay::doorbell
diff --git a/src/splitplay/doorbell.h b/src/splitplay/doorbell.h
new file mode 100644
index 0000000000000000000000000000000000000000..d97c0c03e381bda60e7f979546ca6a242a768d7b
--- /dev/null
+++ b/src/splitplay/doorbell.h
@@ -0,0 +1,52 @@
+/**
+ * @file src/splitplay/doorbell.h
+ * @brief Wakes the control stream thread when gamepad feedback (rumble, LEDs, motion requests) or HDR metadata is
+ * queued, so that it goes to the client at once.
+ *
+ * Upstream sends these from controlBroadcastThread, which drains its queues once per loop and otherwise waits in
+ * enet_host_service() for up to 150 ms; without input from the client only Moonlight's 100 ms ping woke it, so rumble
+ * reached the client up to ~100 ms late. ENet is not thread-safe, so the producers cannot send themselves. Instead
+ * they send one small datagram to the control socket over loopback; the ENet intercept recognises it (a random
+ * per-process token), makes enet_host_service() return, and the loop sends the queued messages right away.
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace splitplay::doorbell {
+  /**
+   * @brief Start answering rings. Called by the control thread once its ENet host is bound.
+   *
+   * @param port The control port.
+   * @param bind_address The address the ENet host is bound to; the wildcard address means loopback.
+   * @param ipv6 The ENet host is an IPv6 (dual-stack) socket.
+   */
+  void arm(std::uint16_t port, const std::string &bind_address, bool ipv6);
+
+  /**
+   * @brief Stop answering rings (the control thread is ending).
+   */
+  void disarm();
+
+  /**
+   * @brief Ask the control thread to send what was queued. Any thread; one datagram until the thread has woken.
+   */
+  void ring();
+
+  /**
+   * @brief Called by the control thread before it drains its queues: rings from now on send a new datagram.
+   */
+  void rearm();
+
+  /**
+   * @brief True when a datagram the ENet host received is the doorbell (ENet must then ignore it).
+   *
+   * @param data Datagram payload.
+   * @param size Payload size in bytes.
+   */
+  bool is_ring(const void *data, std::size_t size);
+}  // namespace splitplay::doorbell
