From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SplitPlay <splitplay@users.noreply.github.com>
Date: Sat, 14 Nov 2026 17:00:00 +0000
Subject: [PATCH] splitplay: FEC need above the minimum parity, key frame
 requests, frame gaps

Three changes to the live stream statistics (docs/contracts/ipc.md):

- burst_loss_pct ignores FEC blocks whose loss the minimum parity covers.
  Every block gets at least the client's minRequiredFecPackets parity
  shards (Moonlight asks for 2), whatever the FEC share. One packet lost
  in a small frame (5 data shards) used to read as a 20 % need, and the
  service's adaptive FEC then held 30 % on a link with no real loss,
  spending a quarter of the video traffic on parity. Packet loss and the
  recovered/failed counts are unchanged.
- idr_requests: key frames the client asked for (IDX_REQUEST_IDR_FRAME)
  since the stream was reported, per stream and summed in metrics.
  Moonlight asks for one when its decode queue overflows (the decoder
  falls behind), when the decoder fails, and after losses reference frame
  invalidation could not repair. The frames it throws away until the key
  frame arrives count as lost in Moonlight's "slow connection to PC"
  check, yet loss_pct never saw them.
- frame_gap_ms_max: the longest pause between two frames sent in the
  interval (frame pacing as the client receives it), per stream and the
  worst in metrics.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J21Rm2JfgMZHfj9R2WKefE

diff --git a/src/splitplay/live_stats.cpp b/src/splitplay/live_stats.cpp
index 0b651ff798d0ea5f23de538be55c3044f8b7ded0..8298244816c3f640b0e6de50b41bb2ce8cc65617 100644
--- a/src/splitplay/live_stats.cpp
+++ b/src/splitplay/live_stats.cpp
@@ -49,6 +49,9 @@ namespace splitplay::live_stats {
     std::atomic<std::uint64_t> fec_failed {0};  ///< FEC blocks the client could not recover.
     std::atomic<std::uint32_t> burst_permille {0};  ///< Worst block of the interval: lost packets per data shard, 1/1000.
     std::atomic<std::uint64_t> lost {0};  ///< Frames the client reported lost.
+    std::atomic<std::uint32_t> gap_us_max {0};  ///< Longest pause between two frames sent in the interval, microseconds.
+    std::int64_t last_sent_ns = 0;  ///< When the previous frame was sent (steady clock); video broadcast thread only.
+    std::atomic<std::uint64_t> idr_requests {0};  ///< Key frames the client asked for since the stream was reported.
     std::atomic<std::int64_t> highest_lost {-1};  ///< Last frame index already counted as lost.
     std::atomic<std::int64_t> rtt_ms {-1};  ///< ENet round-trip time, -1 until the control peer is connected.
 
@@ -174,6 +177,9 @@ namespace splitplay::live_stats {
       stats->seen_fec_recovered = stats->fec_recovered.load(std::memory_order_relaxed);
       stats->seen_fec_failed = stats->fec_failed.load(std::memory_order_relaxed);
       stats->burst_permille.store(0, std::memory_order_relaxed);
+      // Requests sent while the client connected belong to the start-up, not to the stream.
+      stats->idr_requests.store(0, std::memory_order_relaxed);
+      stats->gap_us_max.store(0, std::memory_order_relaxed);
       stats->seen_at = std::chrono::steady_clock::now();
       {
         std::lock_guard lg {stats->samples_mutex};
@@ -247,6 +253,16 @@ namespace splitplay::live_stats {
     stats->frames.fetch_add(1, std::memory_order_relaxed);
     stats->bytes.fetch_add(wire_bytes, std::memory_order_relaxed);
     stats->packets.fetch_add(packets, std::memory_order_relaxed);
+    // Frame pacing as the client receives it: the longest pause between two frames of the interval. Only the video
+    // broadcast thread sends frames, so last_sent_ns needs no synchronisation.
+    const auto now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (stats->last_sent_ns != 0 && now_ns > stats->last_sent_ns) {
+      const auto gap_us = static_cast<std::uint32_t>(std::min<std::int64_t>((now_ns - stats->last_sent_ns) / 1000, std::numeric_limits<std::uint32_t>::max()));
+      auto worst = stats->gap_us_max.load(std::memory_order_relaxed);
+      while (gap_us > worst && !stats->gap_us_max.compare_exchange_weak(worst, gap_us, std::memory_order_relaxed)) {
+      }
+    }
+    stats->last_sent_ns = now_ns;
     if (latency_100us) {
       std::lock_guard lg {stats->samples_mutex};
       if (stats->sample_count < max_samples) {
@@ -272,6 +288,12 @@ namespace splitplay::live_stats {
     stats->lost.fetch_add(std::min(count, max_lost_per_report), std::memory_order_relaxed);
   }
 
+  void idr_requested(session_stats_t *stats) noexcept {
+    if (stats) {
+      stats->idr_requests.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+
   void loss_count(session_stats_t *stats, std::int32_t count) noexcept {
     if (!stats || count <= 0) {
       return;
@@ -318,6 +340,12 @@ namespace splitplay::live_stats {
     stats->fec_missing.fetch_add(missing, std::memory_order_relaxed);
     (recovered ? stats->fec_recovered : stats->fec_failed).fetch_add(1, std::memory_order_relaxed);
 
+    // The minimum parity every block gets covers this loss whatever the FEC share: nothing to learn for it. Without
+    // this, one lost packet of a small frame (5 data shards, 2 parity) read as a 20 % need and kept FEC at 30 %.
+    if (missing <= static_cast<std::uint32_t>(std::max(0, stats->info.min_fec_packets))) {
+      return;
+    }
+
     // The FEC share this block would have needed: lost packets per data shard (at most 65.535 times the data).
     const auto permille = static_cast<std::uint32_t>(std::min<std::uint64_t>(std::uint64_t {missing} * 1000 / status.data_packets, 65535));
     auto worst = stats->burst_permille.load(std::memory_order_relaxed);
@@ -349,6 +377,8 @@ namespace splitplay::live_stats {
     std::uint64_t total_fec_recovered = 0;
     std::uint64_t total_fec_failed = 0;
     std::uint32_t max_burst = 0;
+    std::uint64_t total_idr_requests = 0;
+    std::uint32_t max_gap_us = 0;
     std::int64_t max_rtt = -1;
     json sessions = json::array();
 
@@ -377,6 +407,8 @@ namespace splitplay::live_stats {
         const auto fec_recovered = s->fec_recovered.load(std::memory_order_relaxed);
         const auto fec_failed = s->fec_failed.load(std::memory_order_relaxed);
         const auto burst = s->burst_permille.exchange(0, std::memory_order_relaxed);
+        const auto idr_requests = s->idr_requests.load(std::memory_order_relaxed);
+        const auto gap_us = s->gap_us_max.exchange(0, std::memory_order_relaxed);
 
         const auto d_frames = frames - s->seen_frames;
         const auto d_bytes = bytes - s->seen_bytes;
@@ -408,6 +440,8 @@ namespace splitplay::live_stats {
         entry["burst_loss_pct"] = round1(burst / 10.0);
         entry["fec_recovered"] = d_fec_recovered;
         entry["fec_failed"] = d_fec_failed;
+        entry["idr_requests"] = idr_requests;
+        entry["frame_gap_ms_max"] = round1(gap_us / 1000.0);
         pooled.insert(pooled.end(), mine.begin(), mine.end());
         entry["encode_ms_p50"] = percentile_ms(mine, 0.50);
         entry["encode_ms_p99"] = percentile_ms(mine, 0.99);
@@ -423,6 +457,8 @@ namespace splitplay::live_stats {
         total_fec_recovered += d_fec_recovered;
         total_fec_failed += d_fec_failed;
         max_burst = std::max(max_burst, burst);
+        total_idr_requests += idr_requests;
+        max_gap_us = std::max(max_gap_us, gap_us);
       }
     }
 
@@ -451,6 +487,8 @@ namespace splitplay::live_stats {
       {"fec_recovered", total_fec_recovered},
       {"fec_failed", total_fec_failed},
       {"fec_percent", splitplay::profile::fec_percentage()},
+      {"idr_requests", total_idr_requests},
+      {"frame_gap_ms_max", round1(max_gap_us / 1000.0)},
       {"encoder_kbps", sessions.empty() || splitplay::profile::encoder_kbps() == 0 ? json(nullptr) : json(splitplay::profile::encoder_kbps())},
     };
 
