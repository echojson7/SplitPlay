         {"bitrate_kbps_requested", info.bitrate_kbps_requested},
         {"hdr", info.hdr},
diff --git a/src/splitplay/live_stats.h b/src/splitplay/live_stats.h
index 0efdca58ba5ddab8609bb0b510d7797ba9348e98..7d683cc51976fe95c4f77925615e581ed3590360 100644
--- a/src/splitplay/live_stats.h
+++ b/src/splitplay/live_stats.h
@@ -41,7 +41,8 @@ namespace splitplay::live_stats {
     std::string address;  ///< Client IP address.
     int width = 0;  ///< Requested width in pixels.
     int height = 0;  ///< Requested height in pixels.
-    int fps_requested = 0;  ///< Requested frame rate.
+    int fps_requested = 0;  ///< The stream's frame rate: what the client asked for, at most the desk profile's fps.
+    std::optional<int> fps_client;  ///< What the client asked for when the profile's fps capped it.
     std::string codec;  ///< `h264`, `hevc` or `av1`.
     int bitrate_kbps_requested = 0;  ///< Bitrate the client asked for (its configured bitrate when it sends one).
     bool hdr = false;  ///< The client asked for a 10-bit HDR stream.
diff --git a/src/splitplay/profile.cpp b/src/splitplay/profile.cpp
index 9410e94bf0989078ccd5379203b302d0c27a5e1a..eba4172c91a22a30692b4421c01c23ccc1768f27 100644
--- a/src/splitplay/profile.cpp
+++ b/src/splitplay/profile.cpp
@@ -17,6 +17,7 @@ namespace splitplay::profile {
 
     std::atomic_int fec_percent {unset};
     std::atomic_int min_fps {unset};
+    std::atomic_int max_fps {unset};
     std::atomic_int dpb {unset};
     std::atomic_int pacing_mbps {unset};
     std::atomic<capture_mode_e> mode {capture_mode_e::slot};
@@ -39,6 +40,15 @@ namespace splitplay::profile {
     store(min_fps, value);
   }
 
+  void set_stream_fps(std::optional<int> value) {
+    store(max_fps, value);
+  }
+
+  int stream_fps(int requested) {
+    const int cap = max_fps.load(std::memory_order_relaxed);
+    return cap > 0 && requested > cap ? cap : requested;
+  }
+
   void set_dpb_frames(std::optional<int> value) {
     store(dpb, value);
   }
diff --git a/src/splitplay/profile.h b/src/splitplay/profile.h
index a5ee4a4fa1974e372ef6872c0dccc99afc4f2465..d64c11644bc5fcea497dd057bd9d6d432b013e98 100644
--- a/src/splitplay/profile.h
+++ b/src/splitplay/profile.h
@@ -14,6 +14,7 @@
  * | `dpb_frames`  | NVENC encoder creation                       | next stream (or encoder reinit) |
  * | `capture_mode`| DDA capture loop, every frame                | next frame                    |
  * | `bitrate_cap_kbps` | NVENC encode loop, every frame          | next frame (native NVENC only) |
+ * | `fps`         | RTSP launch                                  | next stream                   |
  */
 // SPDX-License-Identifier: GPL-3.0-only
 #pragma once
@@ -39,6 +40,19 @@ namespace splitplay::profile {
    */
   void set_min_fps(std::optional<int> value);
 
+  /**
+   * @brief The desk profile's frame rate, 1-1000: a stream never runs faster, whatever the client asks for (Moonlight
+   *        offers its display's rate, 180 Hz on a laptop, while the desk's games are limited to the profile's).
+   *        std::nullopt: the client's rate (upstream).
+   * @param value New value or std::nullopt.
+   */
+  void set_stream_fps(std::optional<int> value);
+
+  /**
+   * @brief The frame rate a stream the client asked `requested` for runs at: `requested`, at most the profile's fps.
+   */
+  int stream_fps(int requested);
+
   /**
    * @brief NVENC reference frames kept for reference frame invalidation, 1-16 (AV1 at most 8).
    * 0 or std::nullopt: upstream's 5 (H.264, HEVC) and 8 (AV1). Opt-in: more references than the level allows for
diff --git a/src/stream.cpp b/src/stream.cpp
index 13ad7e1f1254b578d760629ee6a1558dec0b9245..987b85444d0622743ddb3fbe0de64ce6e4e86d4b 100644
--- a/src/stream.cpp
+++ b/src/stream.cpp
@@ -2394,6 +2394,9 @@ namespace stream {
         info.width = config.monitor.width;
         info.height = config.monitor.height;
         info.fps_requested = config.monitor.framerate;
+        if (config.monitor.sp_fps_client > 0) {
+          info.fps_client = config.monitor.sp_fps_client;
+        }
         info.codec = splitplay::live_stats::codec_name(config.monitor.videoFormat);
         info.bitrate_kbps_requested = config.clientBitrateKbps;
         info.hdr = config.monitor.dynamicRange > 0;
