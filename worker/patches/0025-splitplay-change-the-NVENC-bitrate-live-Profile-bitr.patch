diff --git a/src/splitplay/profile.cpp b/src/splitplay/profile.cpp
index e38b04f2ec299e1a2ee76907760b7e9146724184..955724b9f3b664cb016e20b332798a3cc8bcc4a4 100644
--- a/src/splitplay/profile.cpp
+++ b/src/splitplay/profile.cpp
@@ -20,6 +20,11 @@ namespace splitplay::profile {
     std::atomic_int dpb {unset};
     std::atomic_int pacing_mbps {unset};
     std::atomic<capture_mode_e> mode {capture_mode_e::slot};
+    std::atomic_int bitrate_cap {unset};
+    std::atomic<std::uint32_t> live_encoder_kbps {0};
+
+    /// Never ask an encoder for less than this, whatever the cap and FEC share.
+    constexpr std::uint32_t min_encode_kbps = 500;
 
     void store(std::atomic_int &target, std::optional<int> value) {
       target.store(value ? *value : unset, std::memory_order_relaxed);
@@ -46,6 +51,29 @@ namespace splitplay::profile {
     mode.store(value.value_or(capture_mode_e::slot), std::memory_order_relaxed);
   }
 
+  void set_bitrate_cap_kbps(std::optional<int> value) {
+    store(bitrate_cap, value && *value > 0 ? value : std::nullopt);
+  }
+
+  std::uint32_t encode_bitrate_kbps(std::uint32_t stream_kbps) {
+    const int cap = bitrate_cap.load(std::memory_order_relaxed);
+    if (cap == unset || stream_kbps == 0) {
+      return stream_kbps;
+    }
+    // Parity shards add fec % of the data on the wire.
+    const auto fec = static_cast<std::uint64_t>(std::max(fec_percentage(), 0));
+    const auto within_cap = static_cast<std::uint32_t>(static_cast<std::uint64_t>(cap) * 100 / (100 + fec));
+    return std::min(stream_kbps, std::max(within_cap, min_encode_kbps));
+  }
+
+  void set_encoder_kbps(std::uint32_t kbps) {
+    live_encoder_kbps.store(kbps, std::memory_order_relaxed);
+  }
+
+  std::uint32_t encoder_kbps() {
+    return live_encoder_kbps.load(std::memory_order_relaxed);
+  }
+
   capture_mode_e capture_mode() {
     return mode.load(std::memory_order_relaxed);
   }
