<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT -->
<Project>
  <!-- Report which WDK the build really used, and refuse a silent fallback when CI asks for NuGet. -->
  <Target Name="SplitPlayReportWdk" BeforeTargets="PrepareForBuild">
    <Message Importance="High" Text="SplitPlay: $(MSBuildProjectName) WDK_NuGet=$(WDK_NuGet) WDKContentRoot=$(WDKContentRoot) WindowsSdkDir=$(WindowsSdkDir) TargetPlatformVersion=$(TargetPlatformVersion)" />
    <Error Condition="'$(SplitPlayRequireNuGetWdk)' == 'true' and '$(WDK_NuGet)' != 'true'"
           Text="SplitPlay: the WDK NuGet package is not restored (expected $(SplitPlayWdkPackage)). Run: nuget restore drivers\packages.config -PackagesDirectory drivers\packages" />
  </Target>
</Project>
