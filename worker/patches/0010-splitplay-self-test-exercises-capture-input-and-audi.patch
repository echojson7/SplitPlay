diff --git a/src/splitplay/self_test.cpp b/src/splitplay/self_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9f18fb5ab7f71ae5d172913e0b6a2d75ca1b37fd
--- /dev/null
+++ b/src/splitplay/self_test.cpp
@@ -0,0 +1,232 @@
+/**
+ * @file src/splitplay/self_test.cpp
+ * @brief In-session self-test of the SplitPlay worker (`--self-test <seconds>`).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <list>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+// local includes
+#include "options.h"
+#include "self_test.h"
+#include "src/config.h"
+#include "src/display_device.h"
+#include "src/logging.h"
+#include "src/platform/common.h"
+#include "src/video.h"
+
+#ifdef _WIN32
+  // platform includes
+  #include "src/platform/windows/misc.h"
+#endif
+
+using namespace std::literals;
+using json = nlohmann::json;
+
+namespace splitplay::self_test {
+#ifdef _WIN32
+  namespace {
+    using steady = std::chrono::steady_clock;
+
+    /**
+     * @brief Capture the session's display until `deadline` the way a stream does, counting frames.
+     */
+    json capture_until(platf::mem_type_e mem_type, steady::time_point deadline) {
+      ::video::config_t config {};
+      config.width = 1280;
+      config.height = 720;
+      config.framerate = 30;
+      config.bitrate = 10000;
+      config.slicesPerFrame = 1;
+      config.numRefFrames = 1;
+      const auto output_name = display_device::map_output_name(config::video.output_name);
+
+      int frames = 0;
+      int timeouts = 0;
+      int reinits = 0;
+      int width = 0;
+      int height = 0;
+      std::string error;
+      bool cursor = true;
+
+      std::shared_ptr<platf::display_t> disp;
+      std::list<std::shared_ptr<platf::img_t>> imgs;
+      while (steady::now() < deadline) {
+        if (!disp) {
+          disp = platf::display(mem_type, output_name, config);
+          if (!disp) {
+            error = "no display of this session can be captured";
+            std::this_thread::sleep_for(200ms);
+            continue;
+          }
+          error.clear();
+          width = disp->width;
+          height = disp->height;
+        }
+
+        auto push = [&](std::shared_ptr<platf::img_t> &&img, bool frame_captured) {
+          ++(frame_captured ? frames : timeouts);
+          return steady::now() < deadline;
+        };
+        auto pull = [&](std::shared_ptr<platf::img_t> &img_out) {
+          img_out.reset();
+          for (const auto &img : imgs) {
+            if (img.use_count() == 1) {
+              img_out = img;
+              break;
+            }
+          }
+          if (!img_out && imgs.size() < 4) {
+            img_out = disp->alloc_img();
+            if (img_out) {
+              imgs.push_back(img_out);
+            }
+          }
+          if (img_out) {
+            img_out->frame_timestamp.reset();
+          }
+          return static_cast<bool>(img_out);
+        };
+
+        const auto status = disp->capture(push, pull, &cursor);
+        if (status == platf::capture_e::reinit) {
+          // Desktop switch or mode change: open the display again, as the stream does.
+          ++reinits;
+          imgs.clear();
+          disp.reset();
+        } else if (status != platf::capture_e::ok) {
+          error = "capture failed with status " + std::to_string(static_cast<int>(status));
+          break;
+        }
+      }
+      imgs.clear();
+      disp.reset();
+
+      json result {{"frames", frames}, {"timeouts", timeouts}, {"reinits", reinits}, {"width", width}, {"height", height}};
+      if (!error.empty()) {
+        result["error"] = error;
+      }
+      return result;
+    }
+
+    /**
+     * @brief Move the mouse back and forth with SendInput until `stop`, and check that the cursor follows.
+     */
+    json move_mouse_until(const std::atomic_bool &stop) {
+      platf::syncThreadDesktop();
+      auto input = platf::input();
+      POINT start {};
+      const bool have_start = GetCursorPos(&start);
+      int moves = 0;
+      bool moved = false;
+      for (int dx = 40; !stop; dx = -dx) {
+        platf::move_mouse(input, dx, dx / 2);
+        ++moves;
+        POINT now {};
+        if (have_start && GetCursorPos(&now) && (now.x != start.x || now.y != start.y)) {
+          moved = true;
+        }
+        std::this_thread::sleep_for(100ms);
+      }
+      return {{"moves", moves}, {"cursor_moved", moved}};
+    }
+
+    /**
+     * @brief Open the session's default render endpoint through WASAPI loopback, as a stream does.
+     */
+    json read_audio() {
+      json result {{"ok", false}};
+      auto control = platf::audio_control();
+      if (!control) {
+        result["error"] = "audio control unavailable";
+        return result;
+      }
+      auto sink = control->sink_info();
+      if (!sink) {
+        result["error"] = "this session has no default render endpoint";
+        return result;
+      }
+      result["endpoint"] = sink->host;
+
+      constexpr std::uint32_t sample_rate = 48000;
+      constexpr std::uint32_t frame_size = sample_rate * 5 / 1000;  // 5 ms packets, as Moonlight uses
+      const std::uint8_t mapping[] {0, 1};
+      auto mic = control->microphone(mapping, 2, sample_rate, frame_size, true, false);
+      if (!mic) {
+        result["error"] = "WASAPI loopback capture failed";
+        return result;
+      }
+      std::vector<float> buffer(frame_size * 2);
+      int packets = 0;
+      for (int i = 0; i < 100; ++i) {
+        if (mic->sample(buffer) != platf::capture_e::ok) {
+          break;
+        }
+        ++packets;
+      }
+      result["packets"] = packets;
+      result["ok"] = packets > 0;
+      return result;
+    }
+  }  // namespace
+
+  int run(int seconds) {
+    BOOST_LOG(info) << "SplitPlay: self-test for "sv << seconds << " s in session "sv << platf::target_session_id();
+    json result {
+      {"version", splitplay::version()},
+      {"session", platf::target_session_id()},
+    };
+
+    auto mem_type = platf::mem_type_e::system;
+    if (const auto encoder = ::video::chosen_encoder_info()) {
+      result["encoder"] = std::string {encoder->first};
+      mem_type = encoder->second;
+    } else {
+      result["encoder"] = nullptr;
+    }
+    result["capture_memory"] = mem_type == platf::mem_type_e::dxgi ? "gpu" : "system";
+
+    std::atomic_bool stop {false};
+    json input_result;
+    std::thread mouse {[&]() {
+      input_result = move_mouse_until(stop);
+    }};
+    result["capture"] = capture_until(mem_type, std::chrono::steady_clock::now() + std::chrono::seconds {seconds});
+    stop = true;
+    mouse.join();
+    result["input"] = input_result;
+    result["audio"] = read_audio();
+
+    const bool ok = result["capture"]["frames"].get<int>() > 0;
+    result["ok"] = ok;
+    const auto text = result.dump();
+
+    const auto path = platf::appdata() / "self-test.json";
+    std::ofstream {path} << text << '\n';
+    if (ok) {
+      BOOST_LOG(info) << "SplitPlay: self-test passed: "sv << text;
+    } else {
+      BOOST_LOG(error) << "SplitPlay: self-test failed, no frame was captured: "sv << text;
+    }
+    std::cout << text << std::endl;
+    return ok ? 0 : 1;
+  }
+#else
+  int run(int) {
+    BOOST_LOG(error) << "SplitPlay: the self-test is only implemented on Windows"sv;
+    return 1;
+  }
+#endif
+}  // namespace splitplay::self_test
