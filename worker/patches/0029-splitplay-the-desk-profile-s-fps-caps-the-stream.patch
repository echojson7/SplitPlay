@@ -108,6 +108,7 @@ namespace splitplay::control {
       {"pacing_mbps", 1, 100000, &splitplay::profile::set_pacing_mbps, true},
       {"dpb_frames", 0, 16, &splitplay::profile::set_dpb_frames, false},
       {"bitrate_cap_kbps", 0, 1000000, &splitplay::profile::set_bitrate_cap_kbps, true},
+      {"fps", 1, 1000, &splitplay::profile::set_stream_fps, false},
     };
 
     /// The one string field the worker applies: `slot` (default) or `arrival`, live.
