+      const auto sp_frame_bytes = packet->data_size();
 
       auto session = (session_t *) packet->channel_data;
       auto lowseq = session->video.lowseq;
@@ -1865,6 +1870,29 @@ namespace stream {
 
         session->video.lowseq = lowseq;
         splitplay::live_stats::frame_sent(session->sp_stats.get(), sp_wire_bytes, sp_packets, sp_latency);
+        {
+          const auto sp_sent_at = std::chrono::steady_clock::now();
+          auto us = [](std::chrono::steady_clock::time_point from, std::chrono::steady_clock::time_point to) {
+            const auto d = std::chrono::duration_cast<std::chrono::microseconds>(to - from).count();
+            return static_cast<std::uint32_t>(std::clamp<decltype(d)>(d, 0, std::numeric_limits<std::uint32_t>::max()));
+          };
+          auto stage = [&](const std::optional<std::chrono::steady_clock::time_point> &from, const std::optional<std::chrono::steady_clock::time_point> &to) -> std::optional<std::uint32_t> {
+            if (!from || !to) {
+              return std::nullopt;
+            }
+            return us(*from, *to);
+          };
+          splitplay::live_stats::frame_timing_t timing;
+          timing.capture_us = stage(sp_present, packet->sp_encode_start);
+          timing.encode_us = stage(packet->sp_encode_start, packet->sp_encoded_at);
+          timing.queue_us = stage(packet->sp_encoded_at, sp_picked_at);
+          timing.send_us = us(sp_picked_at, sp_sent_at);
+          timing.total_us = stage(sp_present, sp_sent_at);
+          timing.frame_bytes = sp_frame_bytes;
+          timing.key_frame = packet->is_idr();
+          timing.repeated = !sp_present;
+          splitplay::live_stats::frame_timing(session->sp_stats.get(), timing);
+        }
       } catch (const std::exception &e) {
         BOOST_LOG(error) << "Broadcast video failed "sv << e.what();
         std::this_thread::sleep_for(100ms);
