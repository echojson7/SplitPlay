diff --git a/src/splitplay/rdp_input.cpp b/src/splitplay/rdp_input.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1740ebd9aaa408a8a86eb65222b4d5e3d143fbe4
--- /dev/null
+++ b/src/splitplay/rdp_input.cpp
@@ -0,0 +1,358 @@
+/**
+ * @file src/splitplay/rdp_input.cpp
+ * @brief Keyboard and mouse through the seat's RDP connection (see rdp_input.h).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <iterator>
+#include <mutex>
+#include <string>
+
+// SplitPlay contract headers (MIT, copied unmodified from native/include/splitplay by worker/scripts/fetch.sh)
+#include <splitplay/input_ring.h>
+
+// local includes
+#include "options.h"
+#include "rdp_input.h"
+#include "src/globals.h"
+#include "src/logging.h"
+
+// platform includes
+#include <windows.h>
+
+using namespace std::literals;
+
+namespace splitplay::rdp_input {
+  namespace {
+    static_assert(sizeof(SpInputEvent) == 32, "SpInputEvent layout");
+    static_assert((SP_INPUT_RING_CAPACITY & (SP_INPUT_RING_CAPACITY - 1)) == 0, "capacity is a power of two");
+
+    template<class T>
+    std::atomic_ref<T> shared(volatile T &field) {
+      // The ring lives in shared memory; its fields are volatile in the C header and accessed atomically here.
+      return std::atomic_ref<T>(const_cast<T &>(field));
+    }
+
+    std::atomic<sink_e> configured {sink_e::windows};
+    std::atomic<std::uint64_t> full_fallbacks {0};
+
+    // Published by poll() (ready_event first, then ring_view with release), never withdrawn: the mapping stays open
+    // for the worker's lifetime, and a restarted seat reattaches to the same section (input_ring.h).
+    std::atomic<HANDLE> ready_event {nullptr};
+    std::atomic<SpInputRing *> ring_view {nullptr};
+    std::atomic<bool> consumer_alive {false};
+
+    // Input thread only (the ring's single producer).
+    std::uint64_t write_index = 0;
+    bool producer_started = false;
+    std::uint32_t seq = 1;
+    /// The pointer was last moved through SendInput (relative motion without relative mouse PDUs). Clicks and wheel
+    /// then stay on SendInput too: an RDP pointer PDU carries a position, and one read now would be stale by the time
+    /// the PDU arrives, pulling back the motion SendInput delivered meanwhile.
+    bool motion_on_sendinput = false;
+
+    // poll() only, under poll_mutex.
+    std::mutex poll_mutex;
+    HANDLE mapping = nullptr;
+    std::chrono::steady_clock::time_point next_open_attempt {};
+    std::string open_error;
+    DWORD watched_pid = 0;
+    HANDLE watched_process = nullptr;
+    std::string last_status;
+
+    /**
+     * @brief The ring when the sink is RDP and the seat can deliver; otherwise nullptr (use SendInput).
+     */
+    SpInputRing *usable(bool any_sink = false) {
+      if (!any_sink && configured.load(std::memory_order_relaxed) != sink_e::rdp) {
+        return nullptr;
+      }
+      SpInputRing *ring = ring_view.load(std::memory_order_acquire);
+      if (!ring || !consumer_alive.load(std::memory_order_relaxed)) {
+        return nullptr;
+      }
+      if ((shared(ring->flags).load(std::memory_order_acquire) & SP_INPUT_RING_READY) == 0) {
+        return nullptr;
+      }
+      return ring;
+    }
+
+    std::uint64_t free_slots(SpInputRing *ring) {
+      if (!producer_started) {
+        write_index = shared(ring->write_index).load(std::memory_order_acquire);
+        producer_started = true;
+      }
+      const std::uint64_t read_index = shared(ring->read_index).load(std::memory_order_acquire);
+      if (read_index > write_index) {
+        // The seat reinitialised a ring it did not recognise (input_ring.h): follow its indices.
+        write_index = shared(ring->write_index).load(std::memory_order_acquire);
+      }
+      const std::uint64_t used = write_index - read_index;
+      return used >= SP_INPUT_RING_CAPACITY ? 0 : SP_INPUT_RING_CAPACITY - used;
+    }
+
+    /**
+     * @brief Publish one event; false (counted in `dropped`) when the ring is full.
+     */
+    bool push(SpInputRing *ring, std::uint32_t type, std::int32_t a, std::int32_t b = 0, std::int32_t x = 0, std::int32_t y = 0) {
+      const std::uint32_t s = seq++;  // dropped events consume a sequence number too, so the seat sees the gap
+      if (free_slots(ring) == 0) {
+        shared(ring->dropped).fetch_add(1, std::memory_order_relaxed);
+        full_fallbacks.fetch_add(1, std::memory_order_relaxed);
+        return false;
+      }
+      LARGE_INTEGER qpc;
+      QueryPerformanceCounter(&qpc);
+      SpInputEvent &slot = ring->events[write_index & (SP_INPUT_RING_CAPACITY - 1)];
+      slot.qpc = static_cast<std::uint64_t>(qpc.QuadPart);
+      slot.type = type;
+      slot.a = a;
+      slot.b = b;
+      slot.seq = s;
+      slot.x = x;
+      slot.y = y;
+      ++write_index;
+      shared(ring->write_index).store(write_index, std::memory_order_release);
+      return true;
+    }
+
+    void signal() {
+      if (HANDLE event = ready_event.load(std::memory_order_acquire)) {
+        SetEvent(event);
+      }
+    }
+
+    /**
+     * @brief Button or wheel through the ring, at the position the seat last sent (no SP_IN_FLAG_POS: every motion
+     * that reached the session went through the ring too, so the seat's position is the newest one).
+     * @param needed Ring flag the server must have announced for this event, or 0.
+     */
+    bool push_pointer(std::uint32_t type, std::int32_t a, std::uint32_t flags, std::uint32_t needed = 0) {
+      SpInputRing *ring = usable();
+      if (!ring || motion_on_sendinput) {
+        return false;
+      }
+      if (needed && (shared(ring->flags).load(std::memory_order_acquire) & needed) == 0) {
+        return false;
+      }
+      if (!push(ring, type, a, static_cast<std::int32_t>(flags))) {
+        return false;
+      }
+      signal();
+      return true;
+    }
+
+    /**
+     * @brief Open the seat's ring (poll_mutex held). Retried every 2 s until it works.
+     */
+    void try_open() {
+      const auto now = std::chrono::steady_clock::now();
+      if (ring_view.load(std::memory_order_relaxed) || now < next_open_attempt) {
+        return;
+      }
+      next_open_attempt = now + 2s;
+      const std::string &desk = options().desk;
+      if (desk.empty()) {
+        return;
+      }
+      const std::wstring section = L"Global\\SplitPlay.InputRing." + std::wstring(desk.begin(), desk.end());
+      const std::wstring event = L"Global\\SplitPlay.InputReady." + std::wstring(desk.begin(), desk.end());
+      std::string error;
+      HANDLE m = OpenFileMappingW(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, section.c_str());
+      void *view = m ? MapViewOfFile(m, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(SpInputRing)) : nullptr;
+      HANDLE e = view ? OpenEventW(SYNCHRONIZE | EVENT_MODIFY_STATE, FALSE, event.c_str()) : nullptr;
+      if (!m) {
+        error = "no input ring (error " + std::to_string(GetLastError()) + ")";
+      } else if (!view) {
+        error = "cannot map the input ring (error " + std::to_string(GetLastError()) + ")";
+      } else if (!e) {
+        error = "no InputReady event (error " + std::to_string(GetLastError()) + ")";
+      } else {
+        auto *ring = static_cast<SpInputRing *>(view);
+        if (ring->magic != SP_INPUT_RING_MAGIC || ring->version != SP_INPUT_RING_VERSION || ring->capacity != SP_INPUT_RING_CAPACITY) {
+          error = "the input ring has an unknown layout (version " + std::to_string(ring->version) + ")";
+        } else {
+          shared(ring->producer_pid).store(GetCurrentProcessId(), std::memory_order_relaxed);
+          mapping = m;
+          ready_event.store(e, std::memory_order_release);
+          ring_view.store(ring, std::memory_order_release);
+          open_error.clear();
+          BOOST_LOG(info) << "SplitPlay: input ring of desk "sv << desk << " opened (seat pid "sv << ring->consumer_pid << ')';
+          return;
+        }
+      }
+      if (e) {
+        CloseHandle(e);
+      }
+      if (view) {
+        UnmapViewOfFile(view);
+      }
+      if (m) {
+        CloseHandle(m);
+      }
+      if (error != open_error) {
+        BOOST_LOG(warning) << "SplitPlay: RDP input is not available yet: "sv << error << "; keyboard and mouse use SendInput"sv;
+        open_error = error;
+      }
+    }
+
+    /**
+     * @brief Is the process that created the ring (the seat) still running? (poll_mutex held)
+     */
+    bool seat_alive(SpInputRing *ring) {
+      const DWORD pid = shared(ring->consumer_pid).load(std::memory_order_relaxed);
+      if (pid != watched_pid) {
+        if (watched_process) {
+          CloseHandle(watched_process);
+        }
+        watched_process = pid ? OpenProcess(SYNCHRONIZE, FALSE, pid) : nullptr;
+        watched_pid = pid;
+      }
+      return watched_process && WaitForSingleObject(watched_process, 0) == WAIT_TIMEOUT;
+    }
+  }  // namespace
+
+  void set_sink(std::optional<sink_e> value) {
+    const sink_e next = value.value_or(sink_e::windows);
+    const sink_e before = configured.exchange(next);
+    if (before == next) {
+      return;
+    }
+    BOOST_LOG(info) << "SplitPlay: keyboard and mouse input: "sv << (next == sink_e::rdp ? "RDP (through the seat)"sv : "SendInput"sv);
+    if (before == sink_e::rdp) {
+      // Whatever is held over RDP is released there; the input thread is the ring's only producer.
+      input_pool.push([]() {
+        if (SpInputRing *ring = usable(true); ring && push(ring, SP_IN_RELEASE_ALL, 0)) {
+          signal();
+        }
+      });
+    }
+    poll();
+  }
+
+  sink_e sink() {
+    return configured.load(std::memory_order_relaxed);
+  }
+
+  std::string poll() {
+    std::lock_guard lg {poll_mutex};
+    std::string status = "windows";
+    if (configured.load(std::memory_order_relaxed) == sink_e::rdp) {
+      try_open();
+      SpInputRing *ring = ring_view.load(std::memory_order_acquire);
+      const bool alive = ring && seat_alive(ring);
+      consumer_alive.store(alive, std::memory_order_relaxed);
+      const std::uint32_t flags = ring ? shared(ring->flags).load(std::memory_order_acquire) : 0;
+      if (!alive || (flags & SP_INPUT_RING_READY) == 0) {
+        status = "rdp_unavailable";
+      } else {
+        status = (flags & SP_INPUT_RING_REL_MOUSE) ? "rdp" : "rdp_mixed";
+      }
+    }
+    if (status != last_status) {
+      if (!last_status.empty() || status != "windows") {
+        BOOST_LOG(info) << "SplitPlay: input path: "sv << status
+                        << (status == "rdp_mixed"sv ? " (the RDP server has no relative mouse PDUs: relative motion uses SendInput)"sv :
+                            status == "rdp_unavailable"sv ? " (the seat cannot send input now: SendInput)"sv : ""sv);
+      }
+      last_status = status;
+    }
+    return status;
+  }
+
+  std::uint64_t ring_full_fallbacks() {
+    return full_fallbacks.load(std::memory_order_relaxed);
+  }
+
+  bool try_key(std::uint16_t scancode, bool extended, bool e1, bool release) {
+    SpInputRing *ring = usable();
+    if (!ring || scancode == 0 || scancode > 0xFF) {
+      return false;
+    }
+    std::uint32_t flags = (release ? SP_IN_FLAG_UP : 0) | (extended ? SP_IN_FLAG_EXTENDED : 0) | (e1 ? SP_IN_FLAG_E1 : 0);
+    if (!push(ring, SP_IN_KEY, scancode, static_cast<std::int32_t>(flags))) {
+      return false;
+    }
+    signal();
+    return true;
+  }
+
+  bool try_unicode(const wchar_t *text, int count) {
+    SpInputRing *ring = usable();
+    if (!ring || count <= 0) {
+      return false;
+    }
+    // UTF-16 -> code points; unpaired surrogates are dropped.
+    std::uint32_t points[256];
+    int n = 0;
+    for (int i = 0; i < count && n < static_cast<int>(std::size(points)); ++i) {
+      const std::uint32_t u = static_cast<std::uint16_t>(text[i]);
+      if (u >= 0xD800 && u <= 0xDBFF && i + 1 < count) {
+        const std::uint32_t low = static_cast<std::uint16_t>(text[i + 1]);
+        if (low >= 0xDC00 && low <= 0xDFFF) {
+          points[n++] = 0x10000 + ((u - 0xD800) << 10) + (low - 0xDC00);
+          ++i;
+        }
+        continue;
+      }
+      if (u >= 0xD800 && u <= 0xDFFF) {
+        continue;
+      }
+      points[n++] = u;
+    }
+    if (n == 0) {
+      return true;
+    }
+    if (free_slots(ring) < static_cast<std::uint64_t>(2 * n)) {
+      full_fallbacks.fetch_add(1, std::memory_order_relaxed);
+      return false;  // all or nothing: SendInput types the whole text
+    }
+    for (int i = 0; i < n; ++i) {
+      push(ring, SP_IN_UNICODE, static_cast<std::int32_t>(points[i]), 0);
+    }
+    for (int i = 0; i < n; ++i) {
+      push(ring, SP_IN_UNICODE, static_cast<std::int32_t>(points[i]), SP_IN_FLAG_UP);
+    }
+    signal();
+    return true;
+  }
+
+  bool try_mouse_abs(int x, int y) {
+    SpInputRing *ring = usable();
+    if (!ring || !push(ring, SP_IN_MOUSE_ABS, x < 0 ? 0 : x, y < 0 ? 0 : y)) {
+      motion_on_sendinput = true;
+      return false;
+    }
+    motion_on_sendinput = false;
+    signal();
+    return true;
+  }
+
+  bool try_mouse_rel(int dx, int dy) {
+    SpInputRing *ring = usable();
+    if (!ring || (shared(ring->flags).load(std::memory_order_acquire) & SP_INPUT_RING_REL_MOUSE) == 0 || !push(ring, SP_IN_MOUSE_REL, dx, dy)) {
+      // No relative mouse PDUs (raw input keeps its deltas through SendInput), or the ring is not usable
+      motion_on_sendinput = true;
+      return false;
+    }
+    motion_on_sendinput = false;
+    signal();
+    return true;
+  }
+
+  bool try_button(int button, bool release) {
+    // Sunshine: 1 left, 2 middle, 3 right, 4 X1, 5 X2; input_ring.h: 1 left, 2 right, 3 middle, 4 X1, 5 X2.
+    const int ring_button = button == 2 ? 3 : button == 3 ? 2 : button;
+    if (ring_button < 1 || ring_button > 5) {
+      return false;
+    }
+    return push_pointer(SP_IN_BUTTON, ring_button, release ? SP_IN_FLAG_UP : 0, ring_button >= 4 ? SP_INPUT_RING_XBUTTONS : 0);
+  }
+
+  bool try_wheel(int delta, bool horizontal) {
+    return push_pointer(horizontal ? SP_IN_HWHEEL : SP_IN_WHEEL, delta, 0, horizontal ? SP_INPUT_RING_HWHEEL : 0);
+  }
+}  // namespace splitplay::rdp_input
