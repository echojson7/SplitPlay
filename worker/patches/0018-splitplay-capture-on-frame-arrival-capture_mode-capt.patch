@@ -249,6 +257,16 @@ namespace platf::dxgi {
 
     sleep_overshoot_logger.reset();
 
+    // SplitPlay arrival mode (profile `capture_mode`): one stream interval, the shortest gap between two frames
+    // (3/4 of an interval) and the earliest time the rate budget allows the next frame.
+    const auto frame_interval = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::nanoseconds(1s) * client_frame_rate_adjusted.Denominator / client_frame_rate_adjusted.Numerator
+    );
+    const auto min_frame_gap = frame_interval * 3 / 4;
+    std::optional<std::chrono::steady_clock::time_point> last_arrival;
+    std::chrono::steady_clock::time_point arrival_budget {};
+    auto mode = splitplay::profile::capture_mode_e::slot;
+
     while (true) {
       // This will return false if the HDR state changes or for any number of other
       // display or GPU changes. We should reinit to examine the updated state of
@@ -260,8 +278,41 @@ namespace platf::dxgi {
       platf::capture_e status = capture_e::ok;
       std::shared_ptr<img_t> img_out;
 
+      if (const auto wanted = splitplay::profile::capture_mode(); wanted != mode) {
+        mode = wanted;
+        frame_pacing_group_start = std::nullopt;
+        frame_pacing_group_frames = 0;
+        last_arrival = std::nullopt;
+        BOOST_LOG(info) << "SplitPlay: capture mode "sv << (mode == splitplay::profile::capture_mode_e::arrival ? "arrival"sv : "slot"sv);
+      }
+
+      if (mode == splitplay::profile::capture_mode_e::arrival) {
+        // Hand each frame to the encoder as soon as DWM composes it instead of at the next frame slot, which costs
+        // half a stream interval on average. Desktop Duplication accumulates what DWM composes while we wait, so the
+        // frame taken after a wait is the newest one. The average stays at the stream's rate: every frame spends one
+        // interval of budget, and at most one interval can be saved up while frames are sparse.
+        if (last_arrival) {
+          const auto earliest = (std::max)(*last_arrival + min_frame_gap, arrival_budget);
+          if (const auto wait = earliest - std::chrono::steady_clock::now(); wait > 0ns) {
+            timer->sleep_for(wait);
+          }
+        }
+
+        status = snapshot(pull_free_image_cb, img_out, 200ms, *cursor);
+        if (status == capture_e::ok && img_out) {
+          const auto now = std::chrono::steady_clock::now();
+          arrival_budget = (std::max)(arrival_budget, now - frame_interval) + frame_interval;
+          last_arrival = now;
+        } else if (status == platf::capture_e::timeout) {
+          // Nothing changes on screen: let the encoding thread at the device lock (see the slot mode below).
+          std::this_thread::sleep_for(10ms);
+        }
+      }
+
       // Try to continue frame pacing group, snapshot() is called with zero timeout after waiting for client frame interval
-      if (frame_pacing_group_start) {
+      if (mode == splitplay::profile::capture_mode_e::arrival) {
+        // Frame taken above.
+      } else if (frame_pacing_group_start) {
         const uint32_t seconds = (uint64_t) frame_pacing_group_frames * client_frame_rate_adjusted.Denominator / client_frame_rate_adjusted.Numerator;
         const uint32_t remainder = (uint64_t) frame_pacing_group_frames * client_frame_rate_adjusted.Denominator % client_frame_rate_adjusted.Numerator;
         const auto sleep_target = *frame_pacing_group_start +
@@ -291,7 +342,8 @@ namespace platf::dxgi {
       }
 
       // Start new frame pacing group if necessary, snapshot() is called with non-zero timeout
-      if (status == capture_e::timeout || (status == capture_e::ok && !frame_pacing_group_start)) {
+      if (mode != splitplay::profile::capture_mode_e::arrival &&
+          (status == capture_e::timeout || (status == capture_e::ok && !frame_pacing_group_start))) {
         status = snapshot(pull_free_image_cb, img_out, 200ms, *cursor);
 
         if (status == capture_e::ok && img_out) {
