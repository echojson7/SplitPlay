From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SplitPlay <splitplay@users.noreply.github.com>
Date: Fri, 6 Nov 2026 22:39:57 +0000
Subject: [PATCH] splitplay: change the NVENC bitrate live (Profile
 bitrate_cap_kbps)

Sunshine sets the encoder bitrate once, from the client's setting, when a
stream starts. On a link that loses packets because it is full, the only
fix was for the user to lower the bitrate in Moonlight and reconnect.

- The Profile gains `bitrate_cap_kbps` (0-1000000, live; 0 or null = no
  cap): the most video traffic one stream may send, FEC parity included.
  splitplay::profile::encode_bitrate_kbps() turns it into an encoder
  bitrate with the FEC share of the next frame: the stream's own bitrate,
  or less, never below 500 kbit/s.
- The native NVENC encoder keeps the parameters it was initialised with
  and, before each frame, compares the wanted bitrate with the one it
  runs at. On a change it calls NvEncReconfigureEncoder with the new
  average bitrate and the VBV buffer and initial delay scaled with it
  (CBR, no reset, no forced IDR, so the picture does not stall). If the
  driver refuses, the encoder stays at its bitrate for the rest of the
  stream and logs it once.
- Heartbeats gain `metrics.encoder_kbps`, the bitrate the live encoder
  runs at, or null when there is no stream or the encoder cannot change
  it (encoders other than native NVENC keep the client's bitrate).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J21Rm4nQqGPBDq9D7KQv3H

diff --git a/src/nvenc/nvenc_base.cpp b/src/nvenc/nvenc_base.cpp
index 0dca50ab4e5e240c36918280a4db230f2ddbc817..2aad392e9f707362d732e21145526d9015475394 100644
--- a/src/nvenc/nvenc_base.cpp
+++ b/src/nvenc/nvenc_base.cpp
@@ -700,6 +700,17 @@ namespace NVENC_NAMESPACE {
                      << frame_size_format % (client_config.bitrate / 8. / client_config.framerate) << " kB";
     log_created_encoder(init_params, enc_config, config, client_config, buffer_format);
 
+    // SplitPlay: keep what the encoder was initialised with, so that a new bitrate cap can reconfigure it.
+    splitplay_rate = {};
+    splitplay_rate.init_params = init_params;
+    splitplay_rate.enc_config = enc_config;
+    splitplay_rate.init_params.encodeConfig = &splitplay_rate.enc_config;
+    splitplay_rate.stream_kbps = client_config.bitrate > 0 ? static_cast<std::uint32_t>(client_config.bitrate) : 0;
+    splitplay_rate.vbv_bits = enc_config.rcParams.vbvBufferSize;
+    splitplay_rate.vbv_initial_delay = enc_config.rcParams.vbvInitialDelay;
+    splitplay_rate.applied_kbps = splitplay_rate.stream_kbps;
+    splitplay::profile::set_encoder_kbps(splitplay_rate.applied_kbps);
+
     encoder_state = {};
     fail_guard.disable();
     return true;
@@ -734,6 +745,53 @@ namespace NVENC_NAMESPACE {
 
     encoder_state = {};
     encoder_params = {};
+    if (splitplay_rate.stream_kbps != 0) {
+      splitplay::profile::set_encoder_kbps(0);
+    }
+    splitplay_rate = {};
+  }
+
+  void nvenc_base::splitplay_follow_bitrate() {
+    auto &rate = splitplay_rate;
+    if (rate.failed || rate.stream_kbps == 0) {
+      return;
+    }
+    const std::uint32_t target = splitplay::profile::encode_bitrate_kbps(rate.stream_kbps);
+    if (target == rate.applied_kbps) {
+      return;
+    }
+
+    // CBR: the average bitrate and, scaled with it, the VBV buffer (one frame's worth plus the configured increase)
+    // and its initial delay; everything else stays as initialised, so no IDR frame is needed.
+    NV_ENC_CONFIG enc_config = rate.enc_config;
+    enc_config.rcParams.averageBitRate = target * 1000;
+    const auto scale = [&](std::uint32_t base) {
+      return static_cast<std::uint32_t>(static_cast<std::uint64_t>(base) * target / rate.stream_kbps);
+    };
+    if (rate.vbv_bits != 0) {
+      enc_config.rcParams.vbvBufferSize = std::max<std::uint32_t>(scale(rate.vbv_bits), 1);
+    }
+    if (rate.vbv_initial_delay != 0) {
+      enc_config.rcParams.vbvInitialDelay = std::max<std::uint32_t>(scale(rate.vbv_initial_delay), 1);
+    }
+
+    NV_ENC_RECONFIGURE_PARAMS params = {NV_ENC_RECONFIGURE_PARAMS_VER};
+    params.reInitEncodeParams = rate.init_params;
+    params.reInitEncodeParams.encodeConfig = &enc_config;
+    params.resetEncoder = 0;
+    params.forceIDR = 0;
+    if (nvenc_failed(nvenc->nvEncReconfigureEncoder(encoder, &params))) {
+      BOOST_LOG(warning) << "SplitPlay: NvEnc could not change the bitrate to " << target << " kbps, keeping "
+                         << rate.applied_kbps << " kbps for this stream: " << last_nvenc_error_string;
+      rate.failed = true;
+      return;
+    }
+
+    BOOST_LOG(info) << "SplitPlay: NvEnc bitrate " << rate.applied_kbps << " -> " << target << " kbps (stream "
+                    << rate.stream_kbps << " kbps)";
+    rate.enc_config = enc_config;
+    rate.applied_kbps = target;
+    splitplay::profile::set_encoder_kbps(target);
   }
 
   ::nvenc::nvenc_encoded_frame nvenc_base::encode_frame(uint64_t frame_index, bool force_idr) {
@@ -741,6 +799,8 @@ namespace NVENC_NAMESPACE {
       return {};
     }
 
+    splitplay_follow_bitrate();
+
     assert(registered_input_buffer);
     assert(output_bitstream);
 
diff --git a/src/nvenc/nvenc_base.h b/src/nvenc/nvenc_base.h
index d7338bb19d5c0f7498f2c76c5fa5eb099610667e..e406455728b7b66034b0d54d88612f0c0246ef5c 100644
--- a/src/nvenc/nvenc_base.h
+++ b/src/nvenc/nvenc_base.h
@@ -332,6 +332,23 @@ namespace NVENC_NAMESPACE {
 
     NV_ENC_OUTPUT_PTR output_bitstream = nullptr;
 
+    /**
+     * @brief SplitPlay: follow the desk profile's bitrate cap (splitplay::profile::encode_bitrate_kbps) with
+     *        NvEncReconfigureEncoder, without a new IDR frame. Called before every frame; cheap when nothing changed.
+     */
+    void splitplay_follow_bitrate();
+
+    /// SplitPlay live bitrate: the parameters the encoder was initialised with (encodeConfig points to sp_enc_config).
+    struct {
+      NV_ENC_INITIALIZE_PARAMS init_params {};
+      NV_ENC_CONFIG enc_config {};
+      std::uint32_t stream_kbps = 0;  ///< Bitrate the stream was set up with; 0: no live changes.
+      std::uint32_t vbv_bits = 0;  ///< VBV buffer size for stream_kbps (0: the driver's default).
+      std::uint32_t vbv_initial_delay = 0;  ///< Initial VBV delay for stream_kbps (0: the driver's default).
+      std::uint32_t applied_kbps = 0;  ///< Bitrate the encoder runs at now.
+      bool failed = false;  ///< The driver refused a reconfiguration; stay at applied_kbps for this encoder.
+    } splitplay_rate;
+
     struct {
       uint64_t last_encoded_frame_index = 0;
       bool rfi_needs_confirmation = false;
