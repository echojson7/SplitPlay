+/**
+ * @file src/splitplay/live_stats.h
+ * @brief Live stream statistics for the SplitPlay heartbeat and the client_connected/client_disconnected events
+ *        (docs/contracts/ipc.md).
+ *
+ * The streaming threads only bump counters: the video broadcast thread adds one sent frame (wire bytes and the
+ * capture-to-send latency it already computes for Moonlight), the control thread stores the ENet round-trip time
+ * and the frames the client reports lost. Everything else (rates, percentiles, JSON) happens on the heartbeat
+ * thread once per second.
+ *
+ * A stream is reported once it is running (started()) and its client has connected the control stream
+ * (control_connected()), so a launch whose client never gets through is never shown. started(), control_connected()
+ * and ended() only queue the client_connected/client_disconnected events; the heartbeat thread sends them, followed by
+ * the heartbeat, so streaming and RTSP threads never wait on the pipe and the service never reads a heartbeat that
+ * contradicts an event sent before it (a stream missing right after client_connected, or back after
+ * client_disconnected).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+namespace splitplay::live_stats {
+  /**
+   * @brief What the client asked for when the stream was set up. Fixed for the life of the stream.
+   */
+  struct session_info_t {
+    std::uint32_t id = 0;  ///< RTSP launch-session id, unique while the worker runs.
+    std::optional<std::string> client;  ///< Paired client name (empty names are reported as null).
+    std::optional<std::string> client_uuid;  ///< Paired client UUID, as `list_clients` reports it.
+    std::string address;  ///< Client IP address.
+    int width = 0;  ///< Requested width in pixels.
+    int height = 0;  ///< Requested height in pixels.
+    int fps_requested = 0;  ///< Requested frame rate.
+    std::string codec;  ///< `h264`, `hevc` or `av1`.
+    int bitrate_kbps_requested = 0;  ///< Bitrate the client asked for (its configured bitrate when it sends one).
+    bool hdr = false;  ///< The client asked for a 10-bit HDR stream.
+    std::chrono::system_clock::time_point started_at;  ///< When the stream was first reported.
+  };
+
+  /**
+   * @brief Counters of one stream. Opaque; owned by the stream session.
+   */
+  class session_stats_t;
+
+  /**
+   * @brief Map Moonlight's `bitStreamFormat` (0, 1, 2) to `h264`, `hevc` or `av1`.
+   */
+  std::string codec_name(int video_format);
+
+  /**
+   * @brief Create the counters for a stream that is being set up. Nothing is reported until started() and
+   *        control_connected() were both called.
+   */
+  std::shared_ptr<session_stats_t> create(session_info_t info);
+
+  /**
+   * @brief The stream's threads are running (RTSP thread). Once the control peer is connected too, the stream is
+   *        listed in heartbeats and `event client_connected` is queued. Ignored after ended().
+   *
+   * @param stats Counters from create(); null is ignored.
+   * @param address Client IP address.
+   */
+  void started(const std::shared_ptr<session_stats_t> &stats, const std::string &address);
+
+  /**
+   * @brief The client connected the stream's ENet control peer (control thread): the first proof that it reached
+   *        the host after RTSP. Registers the stream when started() was called. Never blocks on I/O.
+   */
+  void control_connected(const std::shared_ptr<session_stats_t> &stats);
+
+  /**
+   * @brief The stream has ended: stop reporting it and queue `event client_disconnected` if it was reported. A
+   *        started() or control_connected() that comes later is ignored. Safe to call twice; never blocks on I/O.
+   */
+  void ended(const std::shared_ptr<session_stats_t> &stats);
+
+  /**
+   * @brief One video frame was put on the wire (video broadcast thread). Two relaxed atomic adds and, when the frame
+   *        has a capture timestamp, one short uncontended lock to store the latency sample.
+   *
+   * @param stats Counters of the frame's stream; null is ignored.
+   * @param wire_bytes Bytes sent for the frame, FEC parity, headers and encryption prefixes included.
+   * @param latency_100us Capture-to-send latency in units of 0.1 ms, as sent to Moonlight in the frame header;
+   *                      empty for frames without a capture timestamp (repeated frames).
+   */
+  void frame_sent(session_stats_t *stats, std::uint64_t wire_bytes, std::optional<std::uint16_t> latency_100us) noexcept;
+
+  /**
+   * @brief The client reported frames `first`..`last` lost (reference frame invalidation request). Frames that an
+   *        earlier report already covered are not counted again.
+   */
+  void frames_lost(session_stats_t *stats, std::int64_t first, std::int64_t last) noexcept;
+
+  /**
+   * @brief Loss count from a legacy loss-stats message (`IDX_LOSS_STATS`).
+   */
+  void loss_count(session_stats_t *stats, std::int32_t count) noexcept;
+
+  /**
+   * @brief Current round-trip time of the stream's ENet control peer, in milliseconds (control thread).
+   */
+  void rtt(session_stats_t *stats, std::uint32_t rtt_ms) noexcept;
+
+  /// Sends one queued event: name and data.
+  using event_sink_t = std::function<void(const std::string &, const nlohmann::json &)>;
+  /// Sends the heartbeat: `metrics` and `sessions`.
+  using heartbeat_sink_t = std::function<void(nlohmann::json, nlohmann::json)>;
+
+  /**
+   * @brief Hand the queued events, then the desk metrics and running streams measured since the previous call, to
+   *        the sinks (heartbeat thread). Every event handed over is already reflected in the sessions and no later
+   *        one is; calls are serialised, so events and heartbeats leave in order.
+   *
+   * @param send_event Receives each queued client_connected/client_disconnected event, oldest first.
+   * @param send_heartbeat Receives `metrics` (`fps`, `bitrate_kbps`, `encode_ms_p50`, `encode_ms_p99`, `loss_pct`,
+   *                       `rtt_ms` (null when no stream has one yet), `clients`) and the `sessions` array.
+   */
+  void report_heartbeat(const event_sink_t &send_event, const heartbeat_sink_t &send_heartbeat);
+}  // namespace splitplay::live_stats
