@@ -284,6 +375,29 @@ namespace splitplay::live_stats {
     }
   }
 
+  void frame_timing(session_stats_t *stats, const frame_timing_t &timing) noexcept {
+    if (!stats) {
+      return;
+    }
+    std::lock_guard lg {stats->samples_mutex};
+    auto &w = stats->timing;
+    w.add(stage_capture, timing.capture_us);
+    w.add(stage_encode, timing.encode_us);
+    w.add(stage_queue, timing.queue_us);
+    w.add(stage_send, timing.send_us);
+    w.add(stage_total, timing.total_us);
+    ++w.frames;
+    w.bytes += timing.frame_bytes;
+    w.max_bytes = std::max(w.max_bytes, timing.frame_bytes);
+    if (timing.key_frame) {
+      ++w.key_frames;
+      w.key_max_bytes = std::max(w.key_max_bytes, timing.frame_bytes);
+    }
+    if (timing.repeated) {
+      ++w.repeated;
+    }
+  }
+
   void frames_lost(session_stats_t *stats, std::int64_t first, std::int64_t last) noexcept {
     // Frame indices are 32-bit on the wire; anything else is a bogus report.
     constexpr std::int64_t max_index = std::numeric_limits<std::uint32_t>::max();
@@ -396,6 +510,7 @@ namespace splitplay::live_stats {
 
