+      /**
+       * @brief Probe the HDR state of the session's displays every few seconds; queue it for the heartbeat thread
+       * when it differs from the last probe (the first probe always does).
+       *
+       * Its own thread, because DXGI and the Display Configuration API can stall while the display configuration
+       * changes (a seat resize, a reconnect), and a heartbeat thread that stalls for 3 s gets the worker killed.
+       */
+      void hdr_probe_loop(std::stop_token st) {
+        std::mutex m;
+        std::condition_variable_any cv;
+        std::string last;
+        while (!st.stop_requested() && !stopping) {
+          auto state = hdr::probe();
+          if (auto text = state.dump(); text != last) {
+            BOOST_LOG(info) << "SplitPlay: display HDR state: "sv << text;
+            last = std::move(text);
+            std::lock_guard lg {hdr_mutex};
+            hdr_change = std::move(state);
+          }
+          std::unique_lock lk {m};
+          cv.wait_for(lk, st, hdr_probe_interval, []() {
+            return false;
+          });
+        }
+      }
+
+      std::optional<json> take_hdr_change() {
+        std::lock_guard lg {hdr_mutex};
+        return std::exchange(hdr_change, std::nullopt);
+      }
