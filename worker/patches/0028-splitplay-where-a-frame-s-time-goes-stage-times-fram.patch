           s->sample_count = 0;
+          timing = s->timing;
+          s->timing = {};
         }
 
         const auto frames = s->frames.load(std::memory_order_relaxed);
@@ -473,6 +591,8 @@ namespace splitplay::live_stats {
         pooled.insert(pooled.end(), mine.begin(), mine.end());
         entry["encode_ms_p50"] = percentile_ms(mine, 0.50);
         entry["encode_ms_p99"] = percentile_ms(mine, 0.99);
+        add_timing(entry, timing);
+        pooled_timing.merge(timing);
         sessions.push_back(std::move(entry));
 
         max_fps = std::max(max_fps, fps);
@@ -519,6 +639,7 @@ namespace splitplay::live_stats {
       {"frame_gap_ms_max", round1(max_gap_us / 1000.0)},
       {"encoder_kbps", sessions.empty() || splitplay::profile::encoder_kbps() == 0 ? json(nullptr) : json(splitplay::profile::encoder_kbps())},
     };
+    add_timing(metrics, pooled_timing);
 
