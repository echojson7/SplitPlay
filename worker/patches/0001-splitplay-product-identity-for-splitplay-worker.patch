diff --git a/src/splitplay/options.cpp b/src/splitplay/options.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5bdc183cd35de2ba6b9a8b2d3d29ea40f68d853b
--- /dev/null
+++ b/src/splitplay/options.cpp
@@ -0,0 +1,208 @@
+/**
+ * @file src/splitplay/options.cpp
+ * @brief Command-line options of the SplitPlay worker (splitplay-worker.exe).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <algorithm>
+#include <mutex>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+#ifdef _WIN32
+  // platform includes
+  #include <windows.h>
+  #include <shellapi.h>
+#endif
+
+// local includes
+#include "options.h"
+
+#ifndef SPLITPLAY_VERSION
+  #define SPLITPLAY_VERSION "0.0.0-dev"
+#endif
+#ifndef SPLITPLAY_UPSTREAM_COMMIT
+  #define SPLITPLAY_UPSTREAM_COMMIT "unknown"
+#endif
+
+using namespace std::literals;
+
+namespace splitplay {
+  namespace {
+    /** Options that take a value, given as `--name value` or `--name=value`. */
+    constexpr std::string_view value_options[] = {
+      "--desk-dir"sv,
+    };
+
+    std::vector<std::string> captured_args;  ///< Arguments recorded by capture_command_line().
+
+    /**
+     * @brief Split `arg` into a SplitPlay value option name and an optional inline value.
+     *
+     * @return True when `arg` is one of `value_options`.
+     */
+    bool match_value_option(std::string_view arg, std::string_view &name, std::string_view &inline_value, bool &has_inline) {
+      for (auto option : value_options) {
+        if (arg == option) {
+          name = option;
+          has_inline = false;
+          return true;
+        }
+        if (arg.size() > option.size() && arg.starts_with(option) && arg[option.size()] == '=') {
+          name = option;
+          inline_value = arg.substr(option.size() + 1);
+          has_inline = true;
+          return true;
+        }
+      }
+      return false;
+    }
+
+    std::filesystem::path path_from_utf8(const std::string &value) {
+      std::u8string u8(value.begin(), value.end());
+      std::error_code ec;
+      auto path = std::filesystem::absolute(std::filesystem::path {u8}, ec);
+      return ec ? std::filesystem::path {u8} : path.lexically_normal();
+    }
+
+    /**
+     * @brief Store the value of a SplitPlay option.
+     */
+    void apply_value(options_t &opts, std::string_view name, const std::string &value) {
+      if (name == "--desk-dir"sv) {
+        opts.desk_dir = path_from_utf8(value);
+      }
+    }
+
+    options_t parse(const std::vector<std::string> &args) {
+      options_t opts;
+      for (std::size_t i = 1; i < args.size(); ++i) {
+        std::string_view arg = args[i];
+        if (arg == "--version"sv) {
+          opts.version = true;
+          continue;
+        }
+        if (arg == "--help"sv) {
+          opts.help = true;
+          continue;
+        }
+
+        std::string_view name, inline_value;
+        bool has_inline = false;
+        if (!match_value_option(arg, name, inline_value, has_inline)) {
+          continue;
+        }
+
+        std::string value;
+        if (has_inline) {
+          value = std::string {inline_value};
+        } else if (i + 1 < args.size()) {
+          value = args[++i];
+        }
+        if (value.empty()) {
+          opts.error = std::string {name} + " requires a value";
+          break;
+        }
+        apply_value(opts, name, value);
+      }
+      return opts;
+    }
+
+#ifdef _WIN32
+    std::string to_utf8(const wchar_t *wide) {
+      const int size = WideCharToMultiByte(CP_UTF8, 0, wide, -1, nullptr, 0, nullptr, nullptr);
+      if (size <= 1) {
+        return {};
+      }
+      std::string out(static_cast<std::size_t>(size - 1), '\0');
+      WideCharToMultiByte(CP_UTF8, 0, wide, -1, out.data(), size, nullptr, nullptr);
+      return out;
+    }
+
+    std::vector<std::string> process_args() {
+      std::vector<std::string> args;
+      int count = 0;
+      LPWSTR *wide = CommandLineToArgvW(GetCommandLineW(), &count);
+      if (wide == nullptr) {
+        return args;
+      }
+      for (int i = 0; i < count; ++i) {
+        args.push_back(to_utf8(wide[i]));
+      }
+      LocalFree(wide);
+      return args;
+    }
+#else
+    std::vector<std::string> process_args() {
+      return captured_args;
+    }
+#endif
+  }  // namespace
+
+  void capture_command_line(int argc, char **argv) {
+    captured_args.assign(argv, argv + argc);
+  }
+
+  const options_t &options() {
+    static const options_t opts = parse(process_args());
+    return opts;
+  }
+
+  int strip_args(int argc, char **argv) {
+    int out = 1;
+    for (int i = 1; i < argc; ++i) {
+      std::string_view name, inline_value;
+      bool has_inline = false;
+      if (match_value_option(argv[i], name, inline_value, has_inline)) {
+        if (!has_inline) {
+          ++i;  // skip the value
+        }
+        continue;
+      }
+      argv[out++] = argv[i];
+    }
+    if (out < argc) {
+      argv[out] = nullptr;
+    }
+    return out;
+  }
+
+  std::string version() {
+    return SPLITPLAY_VERSION;
+  }
+
+  std::string version_string() {
+    return "splitplay-worker "s + SPLITPLAY_VERSION + " (SplitPlay desk worker, based on Sunshine "s + SPLITPLAY_UPSTREAM_COMMIT + ")"s;
+  }
+
+  void print_help_header(std::ostream &out) {
+    out << version_string() << '\n'
+        << "Licensed under GPL-3.0. Source: https://github.com/echojson7/SplitPlay (worker/)\n"
+        << '\n'
+        << "SplitPlay options (removed before the Sunshine options below are parsed):\n"
+        << "    --desk-dir <dir>          | per-desk directory for sunshine.conf, state, credentials and logs\n"
+        << "                              | (default: <executable dir>\\config)\n"
+        << "    --version                 | print the version and exit\n"
+        << '\n';
+  }
+
+  void use_executable_directory_as_cwd() {
+#ifdef _WIN32
+    std::wstring path(MAX_PATH, L'\0');
+    for (;;) {
+      const DWORD len = GetModuleFileNameW(nullptr, path.data(), static_cast<DWORD>(path.size()));
+      if (len == 0) {
+        return;
+      }
+      if (len < path.size()) {
+        path.resize(len);
+        break;
+      }
+      path.resize(path.size() * 2);
+    }
+    std::error_code ec;
+    std::filesystem::current_path(std::filesystem::path {path}.parent_path(), ec);
+#endif
+  }
+}  // namespace splitplay
