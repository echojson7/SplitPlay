+
+  /**
+   * @param stream_kbps The encoder bitrate the stream was set up with (the client's bitrate less the FEC and audio
+   *                    allowance).
+   * @return Encoder bitrate for the next frame: `stream_kbps`, or less so that the video traffic with the current FEC
+   *         share stays within the cap.
+   */
+  std::uint32_t encode_bitrate_kbps(std::uint32_t stream_kbps);
+
+  /**
+   * @brief The bitrate an encoder that can change it live runs at now (kbit/s); 0 when none does (no stream, or an
+   *        encoder other than native NVENC). Reported in heartbeats as `encoder_kbps`.
+   * @param kbps New value.
+   */
+  void set_encoder_kbps(std::uint32_t kbps);
+
+  /**
+   * @return The value of the last set_encoder_kbps().
+   */
+  std::uint32_t encoder_kbps();
+
   /**
    * @return Capture mode for the next frame.
    */
