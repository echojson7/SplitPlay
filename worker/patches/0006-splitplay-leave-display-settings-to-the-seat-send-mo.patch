+   * @param width Requested width in pixels.
+   * @param height Requested height in pixels.
+   * @param fps Requested frame rate.
+   * @param timeout Longest wait for the desktop size to change.
+   */
+  void request_mode(int width, int height, int fps, std::chrono::milliseconds timeout);
+
   /**
    * @brief Stop the heartbeat and reader threads and close the pipe.
    */
