+    // SplitPlay: input is injected on its own thread under MMCSS "Games" instead of on task_pool's single thread,
+    // which also runs unrelated tasks. One thread keeps upstream's ordering and its synchronisation of the input state.
+    input_pool.start(1);
+    input_pool.push([]() {
+      platf::set_thread_name("input::inject");
+      // Lives until the thread ends (deinit_t), which reverts the registration on this thread
+      static thread_local std::optional<splitplay::scheduling::mmcss_t> mmcss;
+      mmcss.emplace("input injection");
+    });
+
     return std::make_unique<deinit_t>();
   }
 
