diff --git a/src/splitplay/profile.cpp b/src/splitplay/profile.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..bb4bf4669060226815676421204c9532cd10dfc3
--- /dev/null
+++ b/src/splitplay/profile.cpp
@@ -0,0 +1,70 @@
+/**
+ * @file src/splitplay/profile.cpp
+ * @brief The stream settings of the desk profile the worker applies (see profile.h).
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+// standard includes
+#include <algorithm>
+#include <atomic>
+
+// local includes
+#include "profile.h"
+#include "src/config.h"
+
+namespace splitplay::profile {
+  namespace {
+    constexpr int unset = -1;
+
+    std::atomic_int fec_percent {unset};
+    std::atomic_int min_fps {unset};
+    std::atomic_int dpb {unset};
+    std::atomic_int pacing_mbps {unset};
+
+    void store(std::atomic_int &target, std::optional<int> value) {
+      target.store(value ? *value : unset, std::memory_order_relaxed);
+    }
+  }  // namespace
+
+  void set_fec_percent(std::optional<int> value) {
+    store(fec_percent, value);
+  }
+
+  void set_min_fps(std::optional<int> value) {
+    store(min_fps, value);
+  }
+
+  void set_dpb_frames(std::optional<int> value) {
+    store(dpb, value);
+  }
+
+  void set_pacing_mbps(std::optional<int> value) {
+    store(pacing_mbps, value);
+  }
+
+  int fec_percentage() {
+    const int value = fec_percent.load(std::memory_order_relaxed);
+    return value == unset ? config::stream.fec_percentage : value;
+  }
+
+  std::uint64_t pacing_bits_per_second() {
+    const int value = pacing_mbps.load(std::memory_order_relaxed);
+    return static_cast<std::uint64_t>(value == unset ? default_pacing_mbps : value) * 1'000'000ULL;
+  }
+
+  double minimum_fps_target(int framerate) {
+    const int value = min_fps.load(std::memory_order_relaxed);
+    if (value != unset) {
+      return static_cast<double>(std::clamp(value, 1, std::max(framerate, 1)));
+    }
+    // Upstream (video.cpp encode_run): the configured target, otherwise half the stream's frame rate.
+    return (config::video.minimum_fps_target > 0.0) ? config::video.minimum_fps_target : (framerate / 2);
+  }
+
+  std::uint32_t dpb_frames(std::uint32_t codec_default, std::uint32_t codec_max) {
+    const int value = dpb.load(std::memory_order_relaxed);
+    if (value == unset) {
+      return codec_default;
+    }
+    return std::clamp(static_cast<std::uint32_t>(std::max(value, 1)), 1U, codec_max);
+  }
+}  // namespace splitplay::profile
diff --git a/src/splitplay/profile.h b/src/splitplay/profile.h
new file mode 100644
index 0000000000000000000000000000000000000000..aca365184734b6354c5617c8af765b7730939aef
--- /dev/null
+++ b/src/splitplay/profile.h
@@ -0,0 +1,75 @@
+/**
+ * @file src/splitplay/profile.h
+ * @brief The stream settings of the desk profile (docs/contracts/ipc.md, "Profile object") the worker applies.
+ *
+ * The control client sets them from `welcome` and `set_profile`; the streaming code reads them where upstream reads
+ * its fixed values or `sunshine.conf` settings. Every value is an atomic of its own, read once per frame or once per
+ * encoder, so a change needs no lock and no restart. Unset means upstream's behaviour.
+ *
+ * | Field         | Read by                                      | Takes effect                  |
+ * |---------------|----------------------------------------------|-------------------------------|
+ * | `fec_percent` | video send, every frame; RTSP launch         | next frame; bitrate allowance on the next stream |
+ * | `min_fps`     | encode loop, every frame                     | next frame                    |
+ * | `pacing_mbps` | video send, every frame                      | next frame                    |
+ * | `dpb_frames`  | NVENC encoder creation                       | next stream (or encoder reinit) |
+ */
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+// standard includes
+#include <cstdint>
+#include <optional>
+
+namespace splitplay::profile {
+  /// Upstream's fixed send pacing: 80 % of 1 Gbit/s per stream.
+  constexpr int default_pacing_mbps = 800;
+
+  /**
+   * @brief Share of FEC parity shards, 0-255 %. std::nullopt: `fec_percentage` from sunshine.conf (default 20).
+   * @param value New value or std::nullopt.
+   */
+  void set_fec_percent(std::optional<int> value);
+
+  /**
+   * @brief Lowest frame rate the encoder keeps up when the desktop does not change, 1-1000.
+   * std::nullopt: `minimum_fps_target` from sunshine.conf, or half the stream's frame rate (upstream).
+   * @param value New value or std::nullopt.
+   */
+  void set_min_fps(std::optional<int> value);
+
+  /**
+   * @brief NVENC reference frames kept for reference frame invalidation, 1-16 (AV1 at most 8).
+   * std::nullopt: upstream's 5 (H.264, HEVC) and 8 (AV1).
+   * @param value New value or std::nullopt.
+   */
+  void set_dpb_frames(std::optional<int> value);
+
+  /**
+   * @brief Send pacing of one stream in Mbit/s, 1-100000. std::nullopt: default_pacing_mbps.
+   * @param value New value or std::nullopt.
+   */
+  void set_pacing_mbps(std::optional<int> value);
+
+  /**
+   * @return FEC percentage for the next frame.
+   */
+  int fec_percentage();
+
+  /**
+   * @return Send pacing in bit/s for the next frame.
+   */
+  std::uint64_t pacing_bits_per_second();
+
+  /**
+   * @param framerate The stream's frame rate.
+   * @return Minimum frame rate the encoder keeps up (the profile's min_fps is capped at `framerate`).
+   */
+  double minimum_fps_target(int framerate);
+
+  /**
+   * @param codec_default Upstream's DPB size for the codec.
+   * @param codec_max Largest DPB size of the codec.
+   * @return DPB size for an encoder the client leaves the reference frame count to.
+   */
+  std::uint32_t dpb_frames(std::uint32_t codec_default, std::uint32_t codec_max);
